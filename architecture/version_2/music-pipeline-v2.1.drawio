        <!-- Header & Badge -->
        <mxCell id="title" value="&lt;font style=&#x27;font-size:21px&#x27;&gt;&lt;b&gt;Pipeline v2.1 as-built (27/11/2026) — Spotify Charts + Spotify Web API + ReccoBeats → Medallion (Supabase) → Airflow + Flask API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#546E7A&#x27;&gt; Chuẩn hoá theo &lt;b&gt;SPEC_V2&lt;/b&gt; (Option B + Ops §19b) &amp;amp; code hiện tại · khối đang chạy dùng &lt;b&gt;viền liền&lt;/b&gt; · hạng mục chưa làm gom riêng &lt;b&gt;viền đứt xám [BACKLOG — §19a / STUB]&lt;/b&gt; (không nối mũi tên luồng chính) · mục chưa kiểm chứng &lt;b&gt;viền đứt vàng&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#263238;fontSize=14;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="8" width="2680" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="badge" value="&lt;b&gt;v2.1 — AS-BUILT (SPEC_V2)&lt;/b&gt;&lt;br&gt;27/11/2026 · Option B + Ops §19b" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;fontColor=#1B5E20;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2760" y="12" width="430" height="56" as="geometry"/>
        </mxCell>

        <!-- Top DAG bar -->
        <mxCell id="dagbar" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;&lt;b&gt;Luồng DAG&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;spotify_weekly&lt;/font&gt; (Airflow 2.9.3 · Docker Compose · &lt;font face=&#x27;Courier New&#x27;&gt;0 9 * * 1&lt;/font&gt; Mon 09:00 Asia/Bangkok · &lt;font face=&#x27;Courier New&#x27;&gt;catchup=False&lt;/font&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;max_active_runs=1&lt;/font&gt;) — &lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT&lt;/b&gt;&lt;/font&gt;:&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;bronze [run_bronze(write_fs=False): ingest → extract_ids → spotify → reccobeats] &amp;gt;&amp;gt; build_silver (DB-only) &amp;gt;&amp;gt; build_gold (DB-only)&lt;/font&gt;&amp;nbsp;&amp;nbsp;+&amp;nbsp;&amp;nbsp;Ops best-effort (&lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs&lt;/font&gt;, không cổng chặn)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#4A148C;fontSize=11;fontStyle=1;spacingLeft=14;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="78" width="3160" height="48" as="geometry"/>
        </mxCell>

        <!-- 7 Swimlane Columns (y=148..1240) -->
        <mxCell id="col_src" value="&lt;b&gt;1. Nguồn dữ liệu (External Sources)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="148" width="440" height="1092" as="geometry"/>
        </mxCell>
        <mxCell id="col_orch" value="&lt;b&gt;2. Orchestrator — Airflow &amp;amp; CLI&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="148" width="390" height="1092" as="geometry"/>
        </mxCell>
        <mxCell id="col_brz" value="&lt;b&gt;3. Bronze &amp;amp; Ops — music.raw_* / Ops&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="940" y="148" width="350" height="1092" as="geometry"/>
        </mxCell>
        <mxCell id="col_enr" value="&lt;b&gt;4. Bên trong Task 1: bronze (run_bronze)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1330" y="148" width="460" height="1092" as="geometry"/>
        </mxCell>
        <mxCell id="col_slv" value="&lt;b&gt;5. Task 2: Silver — music.* (build_silver)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1830" y="148" width="430" height="1092" as="geometry"/>
        </mxCell>
        <mxCell id="col_gld" value="&lt;b&gt;6. Task 3: Gold — music.gold_* (build_gold)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2300" y="148" width="400" height="1092" as="geometry"/>
        </mxCell>
        <mxCell id="col_srv" value="&lt;b&gt;7. Serving — Flask API (built) &amp;amp; BI (BACKLOG)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2740" y="148" width="450" height="1092" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 1: SOURCES ==================== -->
        <mxCell id="src_charts" value="&lt;b&gt;Spotify Charts — public/v0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1565C0&#x27;&gt;&lt;b&gt;AS-BUILT · KHÔNG CẦN AUTH&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;public/v0/charts&lt;/font&gt; (unauthenticated)&lt;br&gt;• Weekly Top Songs: &lt;font face=&#x27;Courier New&#x27;&gt;global&lt;/font&gt;, &lt;b&gt;top 50&lt;/b&gt;&lt;br&gt;• Có: &lt;font face=&#x27;Courier New&#x27;&gt;currentRank, previousRank, trackUri, entryStatus&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Không có streams&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;streams = NULL&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;peakRank / appearancesOnChart&lt;/font&gt; nullable&lt;br&gt;• &lt;b&gt;Chỉ trả tuần live hiện tại&lt;/b&gt; (không có lịch sử tuần cũ)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="190" width="408" height="206" as="geometry"/>
        </mxCell>

        <mxCell id="src_web" value="&lt;b&gt;Spotify Web API&lt;/b&gt; · official&lt;br&gt;&lt;font color=&#x27;#1565C0&#x27;&gt;&lt;b&gt;AS-BUILT · Client Credentials (~3600s)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Single-ID MVP (Q-D=2): &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/tracks/{id}&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/artists/{id}&lt;/font&gt; (batch &lt;font face=&#x27;Courier New&#x27;&gt;?ids=&lt;/font&gt; hoãn)&lt;br&gt;• Có: tên, duration, explicit, album, &lt;font face=&#x27;Courier New&#x27;&gt;release_date&lt;/font&gt;, &lt;b&gt;ISRC&lt;/b&gt;&lt;br&gt;• &lt;font color=&#x27;#C62828&#x27;&gt;&lt;b&gt;Dev Mode (2026):&lt;/b&gt; không trả popularity, followers, genres&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Cấm gọi&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;/v1/audio-features&lt;/font&gt; (đã khoá 27/11/2024 — BR #1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="408" width="408" height="198" as="geometry"/>
        </mxCell>

        <mxCell id="src_rb" value="&lt;b&gt;ReccoBeats — audio-features&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00838F&#x27;&gt;&lt;b&gt;AS-BUILT · Không cần API key&lt;/b&gt;&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;api.reccobeats.com&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/audio-features?ids=&lt;/font&gt; — batch &lt;b&gt;≤ 40&lt;/b&gt; Spotify ID (BR #3–#4)&lt;br&gt;• Đủ 11 audio features (&lt;font face=&#x27;Courier New&#x27;&gt;source_features=&#x27;reccobeats&#x27;&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;id&lt;/font&gt; là ReccoBeats UUID riêng — nối bằng Spotify ID từ &lt;font face=&#x27;Courier New&#x27;&gt;href&lt;/font&gt; / &lt;font face=&#x27;Courier New&#x27;&gt;ISRC&lt;/font&gt;&lt;br&gt;• Client có xử lý HTTP &lt;font face=&#x27;Courier New&#x27;&gt;429 + Retry-After&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="618" width="408" height="178" as="geometry"/>
        </mxCell>

        <mxCell id="src_risk" value="&lt;b&gt;⚠ Rủi ro nguồn &amp;amp; Gap mở&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;public/v0&lt;/font&gt; là endpoint không chính thức; ToS cấm scrape thương mại.&lt;br&gt;• ReccoBeats trễ bài mới: E2E 26/40 (#1–#6 thiếu), live 64–66%.&lt;br&gt;• &lt;b&gt;Gap G8:&lt;/b&gt; client Spotify &amp;amp; Charts chưa có retry 429 (&lt;font face=&#x27;Courier New&#x27;&gt;http.py&lt;/font&gt; còn stub).&lt;br&gt;• &lt;b&gt;Charts auth/v0&lt;/b&gt; (daily Top 200 + streams): &lt;font color=&#x27;#E65100&#x27;&gt;&lt;b&gt;giả định – cần xác nhận&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(cần Bearer user + xác nhận ToS, ngoài MVP)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#B71C1C;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="46" y="808" width="408" height="208" as="geometry"/>
        </mxCell>

        <mxCell id="src_note" value="&lt;b&gt;[NGOÀI SCOPE] Nguồn thay thế dự phòng&lt;/b&gt;&lt;br&gt;kworb (HTML + streams), Last.fm, Kaggle 1.2M, Deezer:&lt;br&gt;chỉ giữ trong tài liệu nghiên cứu v1, không nằm trên luồng chạy." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="46" y="1028" width="408" height="128" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 2: ORCHESTRATOR ==================== -->
        <mxCell id="orch_af" value="&lt;b&gt;Apache Airflow 2.9.3&lt;/b&gt; · Docker Compose (&lt;font face=&#x27;Courier New&#x27;&gt;docker/airflow/&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT — SPEC_V2 Option B (Q11=A)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DAG: &lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;spotify_weekly&lt;/b&gt;&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;dags/spotify_weekly.py&lt;/font&gt;)&lt;br&gt;• Lịch (Q7 stage 2): &lt;font face=&#x27;Courier New&#x27;&gt;0 9 * * 1&lt;/font&gt; (&lt;b&gt;Mon 09:00 Asia/Bangkok&lt;/b&gt;)&lt;br&gt;• &lt;b&gt;Q8a (LOCKED 26/11):&lt;/b&gt; scheduled &lt;font face=&#x27;Courier New&#x27;&gt;chart_date&lt;/font&gt; = &lt;b&gt;Thứ Năm gần nhất&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;trước &lt;font face=&#x27;Courier New&#x27;&gt;data_interval_end&lt;/font&gt; (VD Mon 30/11 → Thu 26/11)&lt;br&gt;• Manual trigger: truyền &lt;font face=&#x27;Courier New&#x27;&gt;params/conf.chart_date&lt;/font&gt; (luôn ưu tiên)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;catchup=False&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;max_active_runs=1&lt;/font&gt; — ~8 tuần &lt;font face=&#x27;Courier New&#x27;&gt;global&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;weekly_top_songs&lt;/font&gt; tích lũy tiến dần (Q3=A, Q10=A; &lt;b&gt;≠ C12&lt;/b&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Chuỗi 3 PythonOperator (Q1=A, Q4=A, Q6=A):&lt;/b&gt;&lt;br&gt;1. &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt; → &lt;font face=&#x27;Courier New&#x27;&gt;run_bronze(wm, write_fs=False)&lt;/font&gt; (retry=1, 5m)&lt;br&gt;2. &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt; → &lt;font face=&#x27;Courier New&#x27;&gt;build_silver(wm)&lt;/font&gt; (retry=1, 1m)&lt;br&gt;3. &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt; → &lt;font face=&#x27;Courier New&#x27;&gt;build_gold(wm)&lt;/font&gt; (retry=1, 1m, no soft_fail)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Recovery (Q2=A):&lt;/b&gt; Clear từ task Silver/Gold lỗi, không tự re-Bronze.&lt;br&gt;• &lt;b&gt;Ops (§19b):&lt;/b&gt; wrapper &lt;font face=&#x27;Courier New&#x27;&gt;_tracked&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;on_failure_callback&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Secret:&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;.env&lt;/font&gt; qua &lt;font face=&#x27;Courier New&#x27;&gt;env_file&lt;/font&gt; container (cài app &lt;font face=&#x27;Courier New&#x27;&gt;--no-deps&lt;/font&gt;, bỏ &lt;font face=&#x27;Courier New&#x27;&gt;flask&lt;/font&gt;)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="526" y="190" width="358" height="552" as="geometry"/>
        </mxCell>

        <mxCell id="orch_wm" value="&lt;b&gt;Watermark &amp;amp; Append Rule&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;state/watermark.py&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (Q8=A, Q8a, Q9=B)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Khóa chu kỳ: &lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;(chart_date, chart_type, country)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;chart_date_before()&lt;/font&gt; tính Thứ Năm trước &lt;font face=&#x27;Courier New&#x27;&gt;data_interval_end&lt;/font&gt;&lt;br&gt;• Bronze append (Q9=B): chạy lại sinh &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; mới; Silver đọc bản mới nhất." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="526" y="754" width="358" height="142" as="geometry"/>
        </mxCell>

        <mxCell id="orch_cli" value="&lt;b&gt;CLI Local / Dev / Repair&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;cli.py&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;pipeline/run.py&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (Q5=A)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;run&lt;/font&gt; = &lt;b&gt;chỉ chạy Bronze&lt;/b&gt; (không bao giờ gộp Silver/Gold; có dual-write FS tùy chọn &lt;font face=&#x27;Courier New&#x27;&gt;data/bronze/&lt;/font&gt;)&lt;br&gt;• Lệnh lẻ: &lt;font face=&#x27;Courier New&#x27;&gt;ingest-charts, enrich-spotify, enrich-reccobeats, build-silver, build-gold&lt;/font&gt;&lt;br&gt;• Còn stub: &lt;font face=&#x27;Courier New&#x27;&gt;backfill-features&lt;/font&gt; (C12), &lt;font face=&#x27;Courier New&#x27;&gt;--offline&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;--report&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="526" y="908" width="358" height="172" as="geometry"/>
        </mxCell>

        <mxCell id="orch_role" value="&lt;b&gt;Ranh giới đóng gói (Q11=A)&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;pyproject.toml&lt;/font&gt; &lt;b&gt;không&lt;/b&gt; phụ thuộc &lt;font face=&#x27;Courier New&#x27;&gt;apache-airflow&lt;/font&gt;.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;pytest -q&lt;/font&gt; chạy offline hoàn toàn trên venv app.&lt;br&gt;• OS cron và SQ-11/GQ-8 đã bị thay thế bởi DAG ở luồng tuần." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="526" y="1092" width="358" height="128" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 3: BRONZE & OPS ==================== -->
        <mxCell id="brz_schema" value="&lt;b&gt;Bronze SoR — Supabase Postgres&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;music.raw_*&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (Q-C=1, Q9=B)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lưu JSONB thô (append-only, không biến đổi nghiệp vụ):&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_charts&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;chart_date, chart_type, country, payload&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_spotify&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;entity: track|artist, spotify_id, payload&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_reccobeats&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;endpoint, spotify_track_ids[], payload&lt;/font&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="956" y="190" width="318" height="236" as="geometry"/>
        </mxCell>

        <mxCell id="brz_meta" value="&lt;b&gt;Metadata mọi dòng Bronze&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;uuid4&lt;/font&gt; cho mỗi lần chạy Bronze)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;ingested_at timestamptz DEFAULT now()&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;source&lt;/font&gt;: &lt;font face=&#x27;Courier New&#x27;&gt;charts_public_v0 | spotify_web_api | reccobeats&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="956" y="438" width="318" height="148" as="geometry"/>
        </mxCell>

        <mxCell id="brz_dq" value="&lt;b&gt;Kiểm tra đầu vào Bronze&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;ingest_charts&lt;/font&gt; kiểm tra &lt;font face=&#x27;Courier New&#x27;&gt;chart_date == live week&lt;/font&gt;&lt;br&gt;• Lệch ngày → &lt;font face=&#x27;Courier New&#x27;&gt;live chart watermark mismatch&lt;/font&gt; (không ghi DB, dừng DAG)&lt;br&gt;• Ghi bằng simple SQL (an toàn với Supabase pooler &lt;font face=&#x27;Courier New&#x27;&gt;:6543&lt;/font&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="956" y="598" width="318" height="154" as="geometry"/>
        </mxCell>

        <mxCell id="brz_ops" value="&lt;b&gt;Ops Observability — SPEC_V2 §19b&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (26/11/2026) — chỉ quan sát, không chặn&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Bảng &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs&lt;/font&gt;: PK &lt;font face=&#x27;Courier New&#x27;&gt;(dag_id, dag_run_id)&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;status (running|success|failed)&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;current_task&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;error_task&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;error_message&lt;/font&gt; (che URI, ≤1000 ký tự),&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;summary jsonb&lt;/font&gt; (lưu kết quả + &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; từng lớp — Option C)&lt;br&gt;• View &lt;font face=&#x27;Courier New&#x27;&gt;music.ops_pipeline_health&lt;/font&gt;: 1 dòng / watermark&lt;br&gt;&amp;nbsp;&amp;nbsp;(&lt;font face=&#x27;Courier New&#x27;&gt;bronze_runs, features_found_pct, silver_stale, bronze_age&lt;/font&gt;)&lt;br&gt;• Ghi bởi &lt;font face=&#x27;Courier New&#x27;&gt;pipeline/ops.py&lt;/font&gt; (chỉ DAG ghi; lỗi chỉ log &lt;font face=&#x27;Courier New&#x27;&gt;WARNING&lt;/font&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#1B5E20;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="956" y="764" width="318" height="266" as="geometry"/>
        </mxCell>

        <mxCell id="brz_store" value="&lt;b&gt;[BACKLOG — §19a / Tùy chọn]&lt;/b&gt;&lt;br&gt;• Tách schema &lt;font face=&#x27;Courier New&#x27;&gt;music_raw / music_silver / music_gold&lt;/font&gt;&lt;br&gt;• Bảng &lt;font face=&#x27;Courier New&#x27;&gt;dq_results&lt;/font&gt;, cột &lt;font face=&#x27;Courier New&#x27;&gt;dq_passed&lt;/font&gt;&lt;br&gt;• Supabase Storage bucket cho file JSON thô (1 GB Free — tùy chọn v1, chưa bật; CLI hiện chỉ có dual-write local &lt;font face=&#x27;Courier New&#x27;&gt;data/bronze/&lt;/font&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="956" y="1042" width="318" height="178" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 4: EXTRACT + ENRICH (INSIDE TASK 1) ==================== -->
        <mxCell id="ex_ids" value="&lt;b&gt;Extract IDs một lần từ Bronze&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;extract_ids.py&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (Q-A=2, Q-B=2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Đọc &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_charts&lt;/font&gt; mới nhất của watermark → tách &lt;font face=&#x27;Courier New&#x27;&gt;track_id&lt;/font&gt; (từ &lt;font face=&#x27;Courier New&#x27;&gt;trackUri&lt;/font&gt;) dùng chung cho cả 2 nhánh enrich (logical fan-out, không gọi lại Charts)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1346" y="190" width="428" height="118" as="geometry"/>
        </mxCell>

        <mxCell id="enr_sp" value="&lt;b&gt;Enrich Spotify Web API&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;enrich/spotify.py&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (trong task bronze)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Single-ID (Q-D=2): &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/tracks/{id}&lt;/font&gt; (~50) + &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/artists/{id}&lt;/font&gt; (~58 từ &lt;font face=&#x27;Courier New&#x27;&gt;track.artists[]&lt;/font&gt; → ~108 calls/run)&lt;br&gt;• &lt;b&gt;Chỉ ghi JSON thô vào &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_spotify&lt;/font&gt;&lt;/b&gt; (không ghi trực tiếp vào Silver)&lt;br&gt;• Batch &lt;font face=&#x27;Courier New&#x27;&gt;?ids=&lt;/font&gt; (≤50): hoãn sau probe F5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#80DEEA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1346" y="320" width="428" height="186" as="geometry"/>
        </mxCell>

        <mxCell id="enr_rb" value="&lt;b&gt;Enrich ReccoBeats&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;enrich/reccobeats.py&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (trong task bronze)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/audio-features?ids=&lt;/font&gt; — dedupe, chia lô &lt;b&gt;≤ 40&lt;/b&gt; Spotify track ID&lt;br&gt;• Retry khi gặp &lt;font face=&#x27;Courier New&#x27;&gt;429 + Retry-After&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Chỉ ghi JSON thô + &lt;font face=&#x27;Courier New&#x27;&gt;spotify_track_ids[]&lt;/font&gt; vào &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_reccobeats&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#006978;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1346" y="518" width="428" height="142" as="geometry"/>
        </mxCell>

        <mxCell id="enr_gap" value="&lt;b&gt;⚠ Độ phủ ReccoBeats quan sát được&lt;/b&gt;&lt;br&gt;• E2E 16/11: &lt;b&gt;26/40&lt;/b&gt; (#1–#6 thiếu). Run thật: 12/11 → &lt;b&gt;32/50 (64%)&lt;/b&gt;, 19/11 → &lt;b&gt;33/50 (66%)&lt;/b&gt;.&lt;br&gt;• Bài thiếu vẫn giữ nguyên ở Silver với &lt;font face=&#x27;Courier New&#x27;&gt;features_found=false&lt;/font&gt; (BR #5–#6). Không dùng search để vá (BR #9)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#B71C1C;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="1346" y="672" width="428" height="114" as="geometry"/>
        </mxCell>

        <mxCell id="enr_dep" value="&lt;b&gt;Trường Spotify Web API bị gỡ / deprecated (Dev Mode 2026)&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;track.popularity, artist.followers, artist.popularity&lt;/font&gt;: REMOVED ở Dev Mode → cột Silver để &lt;font face=&#x27;Courier New&#x27;&gt;NULL&lt;/font&gt;.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist.genres&lt;/font&gt;: Deprecated / thường rỗng.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;external_ids.isrc&lt;/font&gt;: đã được mở lại từ 03/2026 — dùng bình thường." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#E65100;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="1346" y="798" width="428" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="enr_backfill" value="&lt;b&gt;[NGOÀI DAG · STUB] C12 backfill-features&lt;/b&gt;&lt;br&gt;• Ý định: lấy các dòng &lt;font face=&#x27;Courier New&#x27;&gt;dim_track.features_found=false&lt;/font&gt; gọi lại ReccoBeats sau vài tuần.&lt;br&gt;• &lt;b&gt;SPEC_V2 §3 &amp;amp; §9:&lt;/b&gt; tách biệt hẳn với &lt;i&gt;week catch-up&lt;/i&gt;, &lt;b&gt;không&lt;/b&gt; đưa vào DAG &lt;font face=&#x27;Courier New&#x27;&gt;spotify_weekly&lt;/font&gt;; CLI hiện là stub." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="1346" y="960" width="428" height="128" as="geometry"/>
        </mxCell>

        <mxCell id="enr_note" value="&lt;b&gt;Ranh giới I/O mạng (SPEC_V2 §6)&lt;/b&gt;&lt;br&gt;• Chỉ task &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt; (qua &lt;font face=&#x27;Courier New&#x27;&gt;clients/&lt;/font&gt;) được gọi HTTP ra ngoài.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt; và &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt; thuần đọc/ghi Postgres." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1346" y="1100" width="428" height="120" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 5: SILVER ==================== -->
        <mxCell id="slv_dbt" value="&lt;b&gt;Task 2: Python builder&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;build_silver(watermark)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT — DB-only (không HTTP, không dbt)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Chỉ đọc Bronze &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_*&lt;/font&gt; mới nhất&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;ORDER BY ingested_at DESC&lt;/font&gt;)&lt;br&gt;• Chạy one-pass (chung 1 &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; Silver):&lt;br&gt;&amp;nbsp;&amp;nbsp;W1 &lt;font face=&#x27;Courier New&#x27;&gt;fact_chart&lt;/font&gt; → W2 &lt;font face=&#x27;Courier New&#x27;&gt;dim_track&lt;/font&gt; → W3 &lt;font face=&#x27;Courier New&#x27;&gt;dim_artist + bridge&lt;/font&gt; → W4 &lt;font face=&#x27;Courier New&#x27;&gt;features_found&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1846" y="190" width="398" height="174" as="geometry"/>
        </mxCell>

        <mxCell id="slv_fact" value="&lt;b&gt;music.fact_chart&lt;/b&gt; (AS-BUILT)&lt;br&gt;• PK: &lt;font face=&#x27;Courier New&#x27;&gt;(chart_date, chart_type, country, track_id)&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;rank, prev_rank, entry_status, peak_rank, appearances_on_chart&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;streams&lt;/font&gt; nullable (&lt;font face=&#x27;Courier New&#x27;&gt;NULL&lt;/font&gt; trên &lt;font face=&#x27;Courier New&#x27;&gt;public/v0&lt;/font&gt;)&lt;br&gt;• Lineage: &lt;font face=&#x27;Courier New&#x27;&gt;run_id, source, ingested_at&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1846" y="376" width="398" height="132" as="geometry"/>
        </mxCell>

        <mxCell id="slv_dimt" value="&lt;b&gt;music.dim_track&lt;/b&gt; (AS-BUILT)&lt;br&gt;• Metadata Web API: &lt;font face=&#x27;Courier New&#x27;&gt;track_name, duration_ms, explicit, album_*, release_date*, isrc&lt;/font&gt;&lt;br&gt;• ReccoBeats: &lt;font face=&#x27;Courier New&#x27;&gt;reccobeats_uuid, href&lt;/font&gt; + 11 audio features + &lt;font face=&#x27;Courier New&#x27;&gt;source_features=&#x27;reccobeats&#x27;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;features_found&lt;/font&gt; (bool), &lt;font face=&#x27;Courier New&#x27;&gt;features_fetched_at&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;track_popularity&lt;/font&gt; (NULL)&lt;br&gt;• Upsert &lt;font face=&#x27;Courier New&#x27;&gt;COALESCE&lt;/font&gt; + Lineage: &lt;font face=&#x27;Courier New&#x27;&gt;run_id, source, updated_at&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1846" y="520" width="398" height="172" as="geometry"/>
        </mxCell>

        <mxCell id="slv_dima" value="&lt;b&gt;music.dim_artist&lt;/b&gt; (AS-BUILT)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist_id&lt;/font&gt; (PK), &lt;font face=&#x27;Courier New&#x27;&gt;artist_name&lt;/font&gt; (fallback từ &lt;font face=&#x27;Courier New&#x27;&gt;track.artists[]&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;genres, followers, artist_popularity&lt;/font&gt; (nullable trên Dev Mode)&lt;br&gt;• Lineage: &lt;font face=&#x27;Courier New&#x27;&gt;run_id, source, updated_at&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1846" y="704" width="398" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="slv_bridge" value="&lt;b&gt;music.bridge_track_artist&lt;/b&gt; (AS-BUILT)&lt;br&gt;• PK &lt;font face=&#x27;Courier New&#x27;&gt;(track_id, artist_id)&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;artist_position&lt;/font&gt; (0-based)&lt;br&gt;• Hỗ trợ bài hát nhiều nghệ sĩ (collaborators)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1846" y="826" width="398" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="slv_join" value="&lt;b&gt;Quy tắc đọc Silver: LEFT JOIN (BR #6)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT&lt;/b&gt;&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;docs/sql/silver/*.sql&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;fact_chart LEFT JOIN dim_track&lt;/font&gt; (+ &lt;font face=&#x27;Courier New&#x27;&gt;bridge&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;dim_artist&lt;/font&gt;)&lt;br&gt;• Giữ đủ 50 hạng chart kể cả khi thiếu audio features / genres." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1846" y="934" width="398" height="114" as="geometry"/>
        </mxCell>

        <mxCell id="slv_dq" value="&lt;b&gt;[BACKLOG — SPEC_V2 §19a] DQ Gate &amp;amp; dbt Silver&lt;/b&gt;&lt;br&gt;• Cổng chặn &lt;font face=&#x27;Courier New&#x27;&gt;dq_check&lt;/font&gt; trước Gold (kiểm tra đủ 50 dòng, rank 1–50, range [0,1]): &lt;b&gt;chưa triển khai&lt;/b&gt; (DAG khóa 3 task không có task cổng chặn).&lt;br&gt;• Chuyển transform sang &lt;font face=&#x27;Courier New&#x27;&gt;dbt-postgres&lt;/font&gt;: &lt;b&gt;chưa triển khai&lt;/b&gt; (non-goal v2)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="1846" y="1060" width="398" height="160" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 6: GOLD ==================== -->
        <mxCell id="gld_builder" value="&lt;b&gt;Task 3: Python builder&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;build_gold(watermark)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT — DB-only (Q6=A: không soft_fail)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Đọc Silver qua 3 Gold VIEW + &lt;font face=&#x27;Courier New&#x27;&gt;docs/sql/gold/gold_queries.sql&lt;/font&gt;&lt;br&gt;• Trả &lt;font face=&#x27;Courier New&#x27;&gt;GoldBuildResult&lt;/font&gt;: coverage %, missing top-N, movers, mood labels (&lt;font face=&#x27;Courier New&#x27;&gt;0.5&lt;/font&gt; cutover), popularity skip-safe, &lt;font face=&#x27;Courier New&#x27;&gt;scd2=&#x27;deferred&#x27;&lt;/font&gt;&lt;br&gt;• Đóng trạng thái &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs → &#x27;success&#x27;&lt;/font&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2316" y="190" width="368" height="164" as="geometry"/>
        </mxCell>

        <mxCell id="gld_cov" value="&lt;b&gt;music.gold_feature_coverage&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;VIEW&lt;/font&gt; (AS-BUILT)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;fact_chart LEFT JOIN dim_track&lt;/font&gt; theo watermark&lt;br&gt;• Cột: &lt;font face=&#x27;Courier New&#x27;&gt;chart_rows, features_found_rows, features_found_pct&lt;/font&gt;&lt;br&gt;• Được join lại trong &lt;font face=&#x27;Courier New&#x27;&gt;music.ops_pipeline_health&lt;/font&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2316" y="366" width="368" height="122" as="geometry"/>
        </mxCell>

        <mxCell id="gld_movers" value="&lt;b&gt;music.gold_movers&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;VIEW&lt;/font&gt; (AS-BUILT)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;LEFT JOIN&lt;/font&gt; lọc &lt;font face=&#x27;Courier New&#x27;&gt;WHERE prev_rank IS NOT NULL&lt;/font&gt;&lt;br&gt;• Tính &lt;font face=&#x27;Courier New&#x27;&gt;rank_delta = prev_rank - rank&lt;/font&gt; (+ = tăng hạng), &lt;font face=&#x27;Courier New&#x27;&gt;streams&lt;/font&gt; nullable&lt;br&gt;• Phân loại new / re-entry riêng: chưa tách trong VIEW (GQ-2)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2316" y="500" width="368" height="128" as="geometry"/>
        </mxCell>

        <mxCell id="gld_mood" value="&lt;b&gt;music.gold_mood_segments&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;VIEW&lt;/font&gt; (AS-BUILT)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;INNER JOIN dim_track WHERE features_found IS TRUE&lt;/font&gt; (lọc có chủ đích)&lt;br&gt;• Python gán nhãn &lt;font face=&#x27;Courier New&#x27;&gt;energetic / tense / chill / sad&lt;/font&gt; (ngưỡng &lt;font face=&#x27;Courier New&#x27;&gt;0.5&lt;/font&gt;)&lt;br&gt;• Materialized view / bảng snapshot tuần: &lt;b&gt;BACKLOG (§19a)&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2316" y="640" width="368" height="138" as="geometry"/>
        </mxCell>

        <mxCell id="gld_pop" value="&lt;b&gt;⚠ Popularity vs features (G4 skip-safe)&lt;/b&gt;&lt;br&gt;App Dev Mode không trả &lt;font face=&#x27;Courier New&#x27;&gt;track_popularity&lt;/font&gt; → &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt; tự động &lt;font face=&#x27;Courier New&#x27;&gt;skipped=True&lt;/font&gt;, không làm fail pipeline (BR #10)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#B71C1C;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="2316" y="790" width="368" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="gld_backlog" value="&lt;b&gt;[BACKLOG — SPEC_V2 §19a] Mở rộng Gold&lt;/b&gt;&lt;br&gt;• View &lt;b&gt;Rank vs audio features&lt;/b&gt; (thay thế popularity scatter)&lt;br&gt;• Bảng &lt;b&gt;SCD2&lt;/b&gt; lịch sử hạng chính thức (&lt;font face=&#x27;Courier New&#x27;&gt;GQ-5 = deferred&lt;/font&gt;; hiện truy vấn &lt;font face=&#x27;Courier New&#x27;&gt;fact_chart&lt;/font&gt; append-only)&lt;br&gt;• &lt;b&gt;DQ Gold&lt;/b&gt; cảnh báo ngưỡng coverage (cần chọn ngưỡng phù hợp mức 64–66% thực tế)&lt;br&gt;• Tách schema &lt;font face=&#x27;Courier New&#x27;&gt;music_gold&lt;/font&gt; + PostgREST &lt;font face=&#x27;Courier New&#x27;&gt;Accept-Profile: music_gold&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="2316" y="914" width="368" height="306" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 7: SERVING / API & BI ==================== -->
        <mxCell id="srv_flask" value="&lt;b&gt;Local Dashboard HTTP API — Flask&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT&lt;/b&gt;&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;spotify_pipeline.api&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;silver/dashboard.py&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /api/health&lt;/font&gt; → kiểm tra process sống&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /api/charts[?week=YYYY-MM-DD]&lt;/font&gt; → đọc &lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(&lt;font face=&#x27;Courier New&#x27;&gt;REPEATABLE READ READ ONLY&lt;/font&gt; qua &lt;font face=&#x27;Courier New&#x27;&gt;docs/sql/silver/dashboard_*.sql&lt;/font&gt;)&lt;br&gt;• Trả &lt;font face=&#x27;Courier New&#x27;&gt;week, weeks[], tracks[], artists[]&lt;/font&gt;; giữ bài thiếu feature (&lt;font face=&#x27;Courier New&#x27;&gt;featuresFound=false&lt;/font&gt;); mã lỗi &lt;font face=&#x27;Courier New&#x27;&gt;400 / 404 / 503&lt;/font&gt; (không lộ URI DB)&lt;br&gt;• Bind loopback &lt;font face=&#x27;Courier New&#x27;&gt;127.0.0.1:5001&lt;/font&gt; cho TanStack Start dev server; không cài &lt;font face=&#x27;Courier New&#x27;&gt;flask&lt;/font&gt; trong Airflow container (§20)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#1B5E20;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2756" y="190" width="418" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="srv_analytics" value="&lt;b&gt;[STUB — C13] CLI Analytics&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;src/spotify_pipeline/analytics/&lt;/font&gt;)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;movers.py, mood.py, summary.py&lt;/font&gt; và cờ &lt;font face=&#x27;Courier New&#x27;&gt;run --report&lt;/font&gt; hiện còn stub.&lt;br&gt;• Tóm tắt Gold hiện in trực tiếp từ CLI &lt;font face=&#x27;Courier New&#x27;&gt;build-gold&lt;/font&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="2756" y="472" width="418" height="124" as="geometry"/>
        </mxCell>

        <mxCell id="srv_be_ui" value="&lt;b&gt;[BACKLOG — SPEC_V2 §19a / Assumption #7] Public BI &amp;amp; Gold API&lt;/b&gt;&lt;br&gt;• &lt;b&gt;FastAPI BE&lt;/b&gt; đọc Gold (&lt;font face=&#x27;Courier New&#x27;&gt;/api/movers, /api/mood-segments, /api/coverage&lt;/font&gt;) qua PostgREST &lt;font face=&#x27;Courier New&#x27;&gt;music_gold&lt;/font&gt; hoặc role &lt;font face=&#x27;Courier New&#x27;&gt;api_reader&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Public UI&lt;/b&gt;: Streamlit / Next.js (gọi qua BE, giữ kín secret).&lt;br&gt;• &lt;b&gt;Metabase / Grafana&lt;/b&gt; nối thẳng Postgres đọc Gold (&lt;font color=&#x27;#E65100&#x27;&gt;công cụ cụ thể: giả định – cần xác nhận&lt;/font&gt;)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="2756" y="608" width="418" height="292" as="geometry"/>
        </mxCell>

        <mxCell id="srv_rls" value="&lt;b&gt;Ranh giới bảo mật DB &amp;amp; Schema&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Hiện tại (AS-BUILT):&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;SUPABASE_DB_URL&lt;/font&gt; và &lt;font face=&#x27;Courier New&#x27;&gt;SUPABASE_SERVICE_ROLE_KEY&lt;/font&gt; chỉ nằm ở tiến trình Python backend / Airflow container, &lt;b&gt;không lộ ra trình duyệt&lt;/b&gt;.&lt;br&gt;• Tuyệt đối không đụng 3 bảng thời tiết ở &lt;font face=&#x27;Courier New&#x27;&gt;public.weather_*&lt;/font&gt;.&lt;br&gt;• Nếu sau này mở Supabase REST (&lt;font face=&#x27;Courier New&#x27;&gt;anon&lt;/font&gt; key): bắt buộc cấu hình RLS trên Silver + chỉ &lt;font face=&#x27;Courier New&#x27;&gt;GRANT SELECT&lt;/font&gt; trên Gold." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#5D4037;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="2756" y="912" width="418" height="308" as="geometry"/>
        </mxCell>

        <!-- ==================== BOTTOM PLATFORM BAND (8–12) ==================== -->
        <mxCell id="plat" value="&lt;b&gt;8–12. Nền tảng vận hành — Phân định rõ phần ĐÃ CHẠY (AS-BUILT) và phần ĐỂ DÀNH (BACKLOG — SPEC_V2 §19a)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="1268" width="3160" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="plat_mig" value="&lt;b&gt;8. Schema &amp;amp; DDL Migration&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;docs/sql/init/music_schema.sql&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;scripts/ddl/apply_music_ddl.py&lt;/font&gt; (idempotent &lt;font face=&#x27;Courier New&#x27;&gt;IF NOT EXISTS / CREATE OR REPLACE VIEW&lt;/font&gt;)&lt;br&gt;• Schema &lt;font face=&#x27;Courier New&#x27;&gt;music&lt;/font&gt; gồm &lt;b&gt;12 objects&lt;/b&gt;: 3 &lt;font face=&#x27;Courier New&#x27;&gt;raw_*&lt;/font&gt;, 4 Silver, 3 Gold VIEW, &lt;font face=&#x27;Courier New&#x27;&gt;pipeline_runs&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;ops_pipeline_health&lt;/font&gt;; chặn đụng &lt;font face=&#x27;Courier New&#x27;&gt;weather_*&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#546E7A&#x27;&gt;&lt;b&gt;BACKLOG (§19a):&lt;/b&gt; Supabase CLI &lt;font face=&#x27;Courier New&#x27;&gt;supabase/migrations/&lt;/font&gt;, tách &lt;font face=&#x27;Courier New&#x27;&gt;music_raw/silver/gold&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;dq_results&lt;/font&gt;.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="1308" width="612" height="222" as="geometry"/>
        </mxCell>

        <mxCell id="plat_ci" value="&lt;b&gt;9. Kiểm thử &amp;amp; Đóng gói (Q11=A)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;pytest -q&lt;/font&gt; offline hoàn toàn (133 unit/contract tests, không cần Airflow hay mạng sống)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;pyproject.toml&lt;/font&gt; tách rời Airflow; image &lt;font face=&#x27;Courier New&#x27;&gt;docker/airflow/Dockerfile&lt;/font&gt; dùng constraints 2.9.3 và cài package không kèm &lt;font face=&#x27;Courier New&#x27;&gt;flask&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#546E7A&#x27;&gt;&lt;b&gt;BACKLOG (§19a):&lt;/b&gt; GitHub Actions &lt;font face=&#x27;Courier New&#x27;&gt;ci.yml&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;ruff&lt;/font&gt;, DAG parse smoke, &lt;font face=&#x27;Courier New&#x27;&gt;gitleaks&lt;/font&gt;, CD &lt;font face=&#x27;Courier New&#x27;&gt;db push&lt;/font&gt;).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="674" y="1308" width="612" height="222" as="geometry"/>
        </mxCell>

        <mxCell id="plat_mon" value="&lt;b&gt;10. Quan sát &amp;amp; Cảnh báo (Monitoring)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (§19b):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;on_failure_callback&lt;/font&gt; (sau retry cuối) + task wrappers ghi vào &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs&lt;/font&gt;&lt;br&gt;• View &lt;font face=&#x27;Courier New&#x27;&gt;music.ops_pipeline_health&lt;/font&gt; kiểm tra nhanh &lt;font face=&#x27;Courier New&#x27;&gt;features_found_pct, silver_stale, bronze_age&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#546E7A&#x27;&gt;&lt;b&gt;BACKLOG (§19a):&lt;/b&gt; Gửi thông báo ra Slack / Email / Telegram, cảnh báo trễ &amp;gt; 8 ngày, volume anomaly.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="1308" width="612" height="222" as="geometry"/>
        </mxCell>

        <mxCell id="plat_sec" value="&lt;b&gt;11. Bảo mật &amp;amp; Quản lý Secret&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Nạp biến môi trường từ &lt;font face=&#x27;Courier New&#x27;&gt;.env&lt;/font&gt; (gitignored) vào local app &amp;amp; Airflow worker&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;ops.clean_error()&lt;/font&gt; che chuỗi &lt;font face=&#x27;Courier New&#x27;&gt;postgres://...&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;&amp;lt;redacted-uri&amp;gt;&lt;/font&gt;, cắt ≤1000 ký tự); Flask API giấu chi tiết lỗi DB&lt;br&gt;&lt;font color=&#x27;#546E7A&#x27;&gt;&lt;b&gt;BACKLOG (§19a):&lt;/b&gt; Tách 3 role Postgres (&lt;font face=&#x27;Courier New&#x27;&gt;pipeline_writer, dbt_transformer, api_reader&lt;/font&gt;), Airflow Connections, Secret Manager.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1930" y="1308" width="612" height="222" as="geometry"/>
        </mxCell>

        <mxCell id="plat_ops" value="&lt;b&gt;12. Metadata lần chạy &amp;amp; Lineage&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT (§19b — Option C):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;raw_*&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;fact_chart&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;dim_track&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;dim_artist&lt;/font&gt; đều ghi &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;uuid4&lt;/font&gt; mỗi lớp) + &lt;font face=&#x27;Courier New&#x27;&gt;source&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs.summary&lt;/font&gt; gom kết quả &amp;amp; &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; của cả &lt;font face=&#x27;Courier New&#x27;&gt;bronze / build_silver / build_gold&lt;/font&gt; theo &lt;font face=&#x27;Courier New&#x27;&gt;(dag_id, dag_run_id)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#546E7A&#x27;&gt;&lt;b&gt;BACKLOG (§19a):&lt;/b&gt; Ép chung một &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; xuyên suốt 3 lớp hoặc sơ đồ &lt;font face=&#x27;Courier New&#x27;&gt;dbt docs&lt;/font&gt;.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.5;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2558" y="1308" width="612" height="222" as="geometry"/>
        </mxCell>

        <!-- ==================== LEGEND & CHANGELOG (y=1566..1836) ==================== -->
        <mxCell id="legend_swatch" value="&lt;b&gt;Màu lớp &amp;amp; quy ước đường viền&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1565C0&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Nguồn Charts / Spotify Web API&lt;br&gt;&lt;font color=&#x27;#00838F&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; ReccoBeats + bước Extract/Enrich (trong &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#7B1FA2&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Orchestrator Airflow / Watermark / CLI&lt;br&gt;&lt;font color=&#x27;#E65100&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Bronze · &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_*&lt;/font&gt; (append-only JSONB)&lt;br&gt;&lt;font color=&#x27;#455A64&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Silver · &lt;font face=&#x27;Courier New&#x27;&gt;music.*&lt;/font&gt; (Python &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#F9A825&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Gold · &lt;font face=&#x27;Courier New&#x27;&gt;music.gold_*&lt;/font&gt; (3 VIEW + &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Ops (§19b) &amp;amp; Local Flask API (đang chạy)&lt;br&gt;&lt;br&gt;&lt;b&gt;─ Viền liền&lt;/b&gt; = &lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;AS-BUILT&lt;/b&gt;&lt;/font&gt; (đã code &amp;amp; khớp &lt;font face=&#x27;Courier New&#x27;&gt;SPEC_V2&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#78909C&#x27;&gt;&lt;b&gt;▫ Viền đứt xám&lt;/b&gt;&lt;/font&gt; = &lt;b&gt;BACKLOG (§19a) / STUB&lt;/b&gt; (chưa nối luồng)&lt;br&gt;&lt;font color=&#x27;#F9A825&#x27;&gt;&lt;b&gt;▫ Viền đứt vàng&lt;/b&gt;&lt;/font&gt; = giới hạn trường / giả định cần xác nhận&lt;br&gt;&lt;font color=&#x27;#C62828&#x27;&gt;&lt;b&gt;▫ Viền đứt đỏ&lt;/b&gt;&lt;/font&gt; = rủi ro nguồn / ToS / thiếu coverage" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FAFAFA;strokeColor=#90A4AE;fontColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="30" y="1566" width="620" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Chú giải luồng kết nối (khớp SPEC_V2 &amp;amp; code)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Mũi tên liền tím:&lt;/b&gt; điều phối 3 task tuần tự của DAG &lt;font face=&#x27;Courier New&#x27;&gt;spotify_weekly&lt;/font&gt;: &lt;font face=&#x27;Courier New&#x27;&gt;1. bronze &amp;gt;&amp;gt; 2. build_silver &amp;gt;&amp;gt; 3. build_gold&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Mũi tên liền xanh dương / ngọc / cam:&lt;/b&gt; luồng I/O bên trong task &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt; — kéo Charts vào &lt;font face=&#x27;Courier New&#x27;&gt;raw_charts&lt;/font&gt;, đọc &lt;font face=&#x27;Courier New&#x27;&gt;raw_charts&lt;/font&gt; tách IDs một lần, gọi Web API &amp;amp; ReccoBeats rồi ghi về &lt;font face=&#x27;Courier New&#x27;&gt;raw_spotify / raw_reccobeats&lt;/font&gt; (không ghi tắt sang Silver).&lt;br&gt;• &lt;b&gt;Mũi tên liền xám đậm:&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt; đọc thuần DB từ &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_*&lt;/font&gt; mới nhất → upsert &lt;font face=&#x27;Courier New&#x27;&gt;fact_chart, dim_track, dim_artist, bridge_track_artist&lt;/font&gt; (&lt;b&gt;LEFT JOIN&lt;/b&gt; giữ đủ 50 hạng chart).&lt;br&gt;• &lt;b&gt;Mũi tên liền vàng cam:&lt;/b&gt; 3 Gold VIEW chiếu từ Silver → &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt; truy vấn trực tiếp (không đi qua cổng chặn DQ).&lt;br&gt;• &lt;b&gt;Mũi tên liền xanh lá:&lt;/b&gt; Local Flask API (&lt;font face=&#x27;Courier New&#x27;&gt;/api/charts&lt;/font&gt;) đọc &lt;font face=&#x27;Courier New&#x27;&gt;READ ONLY&lt;/font&gt; từ Silver.&lt;br&gt;• &lt;b&gt;Mũi tên đứt xanh lá:&lt;/b&gt; nạp Spotify secret từ &lt;font face=&#x27;Courier New&#x27;&gt;.env&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;env_file&lt;/font&gt;) + ghi Ops best-effort vào &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs&lt;/font&gt;." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FAFAFA;strokeColor=#90A4AE;fontColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="666" y="1566" width="1180" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="changelog" value="&lt;b&gt;Đối chiếu thay đổi: v1 → v2.0 đề xuất (19/11) → v2.1 chuẩn SPEC_V2 (27/11/2026)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Orchestrator:&lt;/b&gt; DAG &lt;font face=&#x27;Courier New&#x27;&gt;spotify_weekly&lt;/font&gt; chạy 3 &lt;font face=&#x27;Courier New&#x27;&gt;PythonOperator&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;bronze &amp;gt;&amp;gt; build_silver &amp;gt;&amp;gt; build_gold&lt;/font&gt;), bật lịch Mon 09:00 Asia/Bangkok, &lt;font face=&#x27;Courier New&#x27;&gt;catchup=False&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;max_active_runs=1&lt;/font&gt;; Q8a khóa Thứ Năm trước &lt;font face=&#x27;Courier New&#x27;&gt;data_interval_end&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Luồng dữ liệu chuẩn Medallion:&lt;/b&gt; gỡ bỏ mũi tên nối tắt từ Extract/Enrich sang Silver và gỡ mũi tên qua cổng DQ giả định; &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt; chỉ đọc &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_*&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt; đọc thẳng 3 Gold VIEW.&lt;br&gt;• &lt;b&gt;Ops (§19b — đã chạy):&lt;/b&gt; chuyển &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;music.ops_pipeline_health&lt;/font&gt; và &lt;font face=&#x27;Courier New&#x27;&gt;on_failure_callback&lt;/font&gt; từ BACKLOG sang AS-BUILT (12 objects trong schema &lt;font face=&#x27;Courier New&#x27;&gt;music&lt;/font&gt;).&lt;br&gt;• &lt;b&gt;Serving:&lt;/b&gt; bổ sung &lt;b&gt;Flask Dashboard API&lt;/b&gt; đọc Silver (&lt;font face=&#x27;Courier New&#x27;&gt;/api/health, /api/charts&lt;/font&gt;) đã có trong repo; giữ FastAPI đọc Gold &amp;amp; public BI ở BACKLOG.&lt;br&gt;• &lt;b&gt;BACKLOG (§19a):&lt;/b&gt; dbt, cổng chặn DQ, &lt;font face=&#x27;Courier New&#x27;&gt;dq_results&lt;/font&gt;, tách 3 schema &amp;amp; 3 role, Supabase CLI, GitHub Actions, Slack/Email notify, Airflow Connections." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="1862" y="1566" width="1328" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="Bản v2.1 cập nhật 27/11/2026 (Asia/Bangkok) đồng bộ SPEC_V2 &amp;amp; SPEC.md — phần BACKLOG giữ nguyên ranh giới SPEC_V2 §19a. Sơ đồ v1 tại architecture/version_1/music-pipeline.drawio (16/11) · đề xuất gốc v2.0 giữ nguyên tại architecture/version_2/music-pipeline-v2.0.drawio (19/11).&lt;br&gt;Không đụng 3 bảng thời tiết trong schema public. Không ghi key/URI thật vào sơ đồ." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#78909C;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="1848" width="3160" height="48" as="geometry"/>
        </mxCell>


<diagram id="music-pipeline-v2.1" name="Pipeline nhạc v2.1 as-built (26/11/2026)"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Original" parent="0"/><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CFD8DC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3220" height="1900" as="geometry"/></mxCell><mxCell id="title" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;Pipeline v2.1 as-built (26/11/2026) — Spotify Charts + Spotify Web API + ReccoBeats → Medallion (Supabase) → Airflow&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#546E7A&#x27;&gt;As-built theo SPEC_V2 (Option B) · khối đã chạy gắn nhãn &lt;b&gt;&amp;quot;as-built&amp;quot;&lt;/b&gt; · ý chưa triển khai từ đề xuất v2.0 gắn nhãn &lt;b&gt;&amp;quot;BACKLOG&amp;quot;&lt;/b&gt; (SPEC_V2 §19a) · mục chưa kiểm chứng gắn &lt;b&gt;&amp;quot;giả định – cần xác nhận&amp;quot;&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#263238;fontSize=14;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="2680" height="64" as="geometry"/></mxCell><mxCell id="badge" value="&lt;b&gt;v2.1 — AS-BUILT&lt;/b&gt;&lt;br&gt;26/11/2026 · Asia/Bangkok" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 6;align=center;verticalAlign=middle;fontColor=#2E7D32;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2760" y="12" width="430" height="56" as="geometry"/></mxCell><mxCell id="dagbar" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;&lt;b&gt;Luồng DAG&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;spotify_weekly&lt;/font&gt; (Airflow · Docker Compose local) — &lt;font color=&#x27;#2E7D32&#x27;&gt;as-built&lt;/font&gt;:&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;bronze (run_bronze: ingest + enrich) → build_silver → build_gold&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#4A148C;fontSize=11;fontStyle=1;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="3160" height="50" as="geometry"/></mxCell><mxCell id="col_src" value="&lt;b&gt;1. Nguồn (Sources)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="146" width="440" height="1084" as="geometry"/></mxCell><mxCell id="col_orch" value="&lt;b&gt;2. Orchestrator — Airflow&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="510" y="146" width="390" height="1084" as="geometry"/></mxCell><mxCell id="col_brz" value="&lt;b&gt;3. Bronze — music.raw_*&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="940" y="146" width="350" height="1084" as="geometry"/></mxCell><mxCell id="col_enr" value="&lt;b&gt;4. Extract + Enrich (EL)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1330" y="146" width="460" height="1084" as="geometry"/></mxCell><mxCell id="col_slv" value="&lt;b&gt;5. Silver — music.* (Python builders)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1830" y="146" width="430" height="1084" as="geometry"/></mxCell><mxCell id="col_gld" value="&lt;b&gt;6. Gold — music.gold_* (VIEW)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2300" y="146" width="400" height="1084" as="geometry"/></mxCell><mxCell id="col_srv" value="&lt;b&gt;7. Serving / BI — BACKLOG&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2740" y="146" width="450" height="1084" as="geometry"/></mxCell><mxCell id="src_charts" value="&lt;b&gt;Spotify Charts — public/v0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1565C0&#x27;&gt;&lt;b&gt;KHÔNG CẦN AUTH · ĐÃ TEST 16/11/2026&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;public/v0/charts&lt;/font&gt; (unauthenticated)&lt;br&gt;• Weekly Top Songs: Global, &lt;b&gt;top 50&lt;/b&gt;&lt;br&gt;• Có: &lt;font face=&#x27;Courier New&#x27;&gt;currentRank&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;previousRank&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;trackUri&lt;/font&gt;, tên bài / nghệ sĩ, &lt;font face=&#x27;Courier New&#x27;&gt;entryStatus&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Không có streams&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;peakRank&lt;/font&gt; / &lt;font face=&#x27;Courier New&#x27;&gt;appearancesOnChart&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;thường = 0 hoặc rỗng → cột cho phép NULL&lt;br&gt;• Cadence quan sát được: &lt;b&gt;weekly&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="46" y="194" width="408" height="210" as="geometry"/></mxCell><mxCell id="src_web" value="&lt;b&gt;Spotify Web API&lt;/b&gt; · official&lt;br&gt;Client Credentials · token ~1 giờ (&lt;font face=&#x27;Courier New&#x27;&gt;expires_in=3600&lt;/font&gt;)&lt;br&gt;• Metadata: tên, duration, explicit, album,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;release_date&lt;/font&gt;, &lt;b&gt;ISRC&lt;/b&gt; (vẫn có, reverted 3/2026)&lt;br&gt;• &lt;font color=&#x27;#C62828&#x27;&gt;&lt;b&gt;Dev Mode&lt;/b&gt; (từ 11/02/2026): &lt;b&gt;không có&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;popularity, followers, genres&lt;/font&gt;&lt;br&gt;• Không dùng &lt;font face=&#x27;Courier New&#x27;&gt;audio-features&lt;/font&gt; (khoá 27/11/2024)&lt;br&gt;• App Dev Mode mới: batch &lt;font face=&#x27;Courier New&#x27;&gt;/tracks?ids=&lt;/font&gt; có thể&lt;br&gt;&amp;nbsp;&amp;nbsp;bị gỡ — fallback từng id" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="46" y="416" width="408" height="200" as="geometry"/></mxCell><mxCell id="src_rb" value="&lt;b&gt;ReccoBeats — audio-features&lt;/b&gt;&lt;br&gt;Không cần API key · &lt;font face=&#x27;Courier New&#x27;&gt;api.reccobeats.com&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/audio-features?ids=&lt;/font&gt; batch ≤ 40&lt;br&gt;• Đủ 11 audio features (danceability, energy,&lt;br&gt;&amp;nbsp;&amp;nbsp;valence, tempo, …)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;id&lt;/font&gt; là UUID riêng, &lt;b&gt;không&lt;/b&gt; phải Spotify ID&lt;br&gt;• Nối dữ liệu bằng &lt;b&gt;ISRC&lt;/b&gt; hoặc Spotify ID&lt;br&gt;&amp;nbsp;&amp;nbsp;đã gửi khi gọi" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="46" y="628" width="408" height="176" as="geometry"/></mxCell><mxCell id="src_risk" value="&lt;b&gt;⚠ Rủi ro nguồn&lt;/b&gt;&lt;br&gt;• Không có official Charts API cho developer.&lt;br&gt;• public/v0 là endpoint &lt;b&gt;không chính thức&lt;/b&gt;.&lt;br&gt;• ToS Spotify cấm scraping Charts.&lt;br&gt;• ReccoBeats: thiếu bài mới (E2E 16/11/2026:&lt;br&gt;&amp;nbsp;&amp;nbsp;26/40, #1–#6 thiếu); rate limit không công bố.&lt;br&gt;• &lt;b&gt;auth/v0 daily + streams&lt;/b&gt;: &lt;font color=&#x27;#E65100&#x27;&gt;giả định – cần xác nhận&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(cần Bearer user, chưa gọi thành công)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#B71C1C;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="46" y="816" width="408" height="200" as="geometry"/></mxCell><mxCell id="src_note" value="&lt;b&gt;Fallback — không nằm trên luồng chính&lt;/b&gt;&lt;br&gt;kworb (daily HTML + streams), Last.fm,&lt;br&gt;Kaggle 1.2M, Deezer: chỉ dùng nếu Charts&lt;br&gt;public/v0 hoặc auth/v0 không dùng được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#546E7A;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="46" y="1028" width="408" height="132" as="geometry"/></mxCell><mxCell id="orch_af" value="&lt;b&gt;Apache Airflow&lt;/b&gt; · Docker Compose (local)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DAG: &lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;spotify_weekly&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Lịch: Mon 09:00 Asia/Bangkok (&lt;font face=&#x27;Courier New&#x27;&gt;0 9 * * 1&lt;/font&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;chart_date = Thứ Năm trước data_interval_end (Q8a)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;retries=1&lt;/font&gt; (bronze 5 phút, silver/gold 1 phút)&lt;br&gt;&amp;nbsp;&amp;nbsp;429 retry hiện chỉ có ở client ReccoBeats&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;max_active_runs=1&lt;/font&gt; — tránh 2 run ghi đè&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;catchup=False&lt;/font&gt; — public/v0 chỉ có tuần live; 8 tuần tích lũy dần&lt;br&gt;• Manual: DAG params/conf &lt;font face=&#x27;Courier New&#x27;&gt;chart_date&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Chuỗi task (ràng buộc thứ tự)&lt;/b&gt;&lt;br&gt;1. &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt; (run_bronze)&lt;br&gt;2. &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt;&lt;br&gt;3. &lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt;&lt;br&gt;&lt;br&gt;Airflow chỉ điều phối, gọi các builder Python.&lt;br&gt;Secret: .env qua env_file của container (Airflow Connections: BACKLOG)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="526" y="194" width="358" height="560" as="geometry"/></mxCell><mxCell id="orch_wm" value="&lt;b&gt;Watermark&lt;/b&gt; (giữ từ v1)&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;chart_date + chart_type + country&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mỗi run = một watermark. Bronze append (Q9=B):&lt;br&gt;chạy lại tạo run_id mới, Silver/Gold đọc bản mới nhất." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="526" y="766" width="358" height="126" as="geometry"/></mxCell><mxCell id="orch_cli" value="&lt;b&gt;Python app&lt;/b&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;spotify_pipeline&lt;/font&gt;)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DAG gọi thẳng &lt;font face=&#x27;Courier New&#x27;&gt;run_bronze&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt;,&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;build_gold&lt;/font&gt; (PythonOperator).&lt;br&gt;CLI (&lt;font face=&#x27;Courier New&#x27;&gt;cli.py&lt;/font&gt;) giữ cho dev / repair;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;run&lt;/font&gt; chỉ làm Bronze." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="526" y="904" width="358" height="160" as="geometry"/></mxCell><mxCell id="orch_role" value="&lt;b&gt;Phân vai (v2.1 as-built)&lt;/b&gt;&lt;br&gt;Python = Bronze + Silver + Gold builders.&lt;br&gt;Airflow = lịch, retry, thứ tự task, recovery theo task." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="526" y="1076" width="358" height="128" as="geometry"/></mxCell><mxCell id="brz_schema" value="&lt;b&gt;Schema&lt;/b&gt; &lt;font face=&#x27;Courier New&#x27;&gt;music&lt;/font&gt; (raw_*)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Supabase Postgres — JSON thô, không transform.&lt;br&gt;Tách music_raw / silver / gold: BACKLOG&lt;br&gt;(cần migration).&lt;br&gt;&lt;br&gt;&lt;b&gt;Bảng raw (cột jsonb + metadata)&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;raw_charts&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;raw_spotify&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;raw_reccobeats&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="956" y="194" width="318" height="260" as="geometry"/></mxCell><mxCell id="brz_meta" value="&lt;b&gt;Metadata mọi dòng raw / fact&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; (UUID hoặc Airflow run_id)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;ingested_at timestamptz&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;source&lt;/font&gt;: spotify_charts /&lt;br&gt;&amp;nbsp;&amp;nbsp;spotify_web_api / reccobeats" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="956" y="466" width="318" height="150" as="geometry"/></mxCell><mxCell id="brz_store" value="&lt;b&gt;Supabase Storage&lt;/b&gt; (tùy chọn)&lt;br&gt;Lưu file JSON thô song song với bảng raw.&lt;br&gt;Phân vùng theo watermark + ingested_at.&lt;br&gt;&lt;font color=&#x27;#E65100&#x27;&gt;Tùy chọn — giả định – cần xác nhận&lt;/font&gt;&lt;br&gt;nếu có dùng (gói Free: 1 GB storage)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#E65100;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="956" y="628" width="318" height="140" as="geometry"/></mxCell><mxCell id="brz_dq" value="&lt;b&gt;DQ Bronze (as-built, tối thiểu)&lt;/b&gt;&lt;br&gt;• Ingest kiểm tra chart_date == tuần live&lt;br&gt;&amp;nbsp;&amp;nbsp;(sai → &lt;font face=&#x27;Courier New&#x27;&gt;live chart watermark mismatch&lt;/font&gt;, không ghi gì)&lt;br&gt;• Lỗi → task bronze fail, downstream không chạy&lt;br&gt;DQ gate đầy đủ: BACKLOG" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="956" y="780" width="318" height="140" as="geometry"/></mxCell><mxCell id="brz_ops" value="&lt;b&gt;Ops — BUILT (SPEC_V2 §19b)&lt;/b&gt;&lt;br&gt;• table &lt;font face=&#x27;Courier New&#x27;&gt;music.pipeline_runs&lt;/font&gt;&lt;br&gt;  key (dag_id, dag_run_id), status, summary jsonb&lt;br&gt;• view &lt;font face=&#x27;Courier New&#x27;&gt;music.ops_pipeline_health&lt;/font&gt;&lt;br&gt;  coverage, silver_stale, bronze_age&lt;br&gt;&lt;font color=&#x27;#C62828&#x27;&gt;&lt;b&gt;BACKLOG:&lt;/b&gt; dq_results, dq_passed, DQ gate&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="956" y="932" width="318" height="228" as="geometry"/></mxCell><mxCell id="ex_ids" value="&lt;b&gt;Extract Spotify track / artist IDs&lt;/b&gt;&lt;br&gt;Từ &lt;font face=&#x27;Courier New&#x27;&gt;trackUri&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;spotify:track:{id}&lt;/font&gt;) → track_id 22 ký tự.&lt;br&gt;Artist ID lấy sau từ payload Web API &lt;font face=&#x27;Courier New&#x27;&gt;tracks.artists[].id&lt;/font&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1346" y="194" width="428" height="96" as="geometry"/></mxCell><mxCell id="enr_sp" value="&lt;b&gt;Gọi Spotify Web API&lt;/b&gt; (trong task &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt;)&lt;br&gt;• as-built: từng id (Q-D=2, batch hoãn)&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/tracks/{id}&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/artists/{id}&lt;/font&gt;&lt;br&gt;• Batch &lt;font face=&#x27;Courier New&#x27;&gt;?ids=&lt;/font&gt; (tracks/artists ≤ 50, albums ≤ 20): BACKLOG&lt;br&gt;Ghi raw JSON vào &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_spotify&lt;/font&gt; (append, run_id mới mỗi lần).&lt;br&gt;Không lấy audio-features từ Spotify (khoá 27/11/2024)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#80DEEA;strokeColor=#00838F;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1346" y="302" width="428" height="210" as="geometry"/></mxCell><mxCell id="enr_rb" value="&lt;b&gt;Gọi ReccoBeats&lt;/b&gt; (trong task &lt;font face=&#x27;Courier New&#x27;&gt;bronze&lt;/font&gt;)&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/audio-features?ids=&lt;/font&gt; — batch ≤ 40 Spotify ID.&lt;br&gt;Retry 429 / Retry-After. Ghi raw vào &lt;font face=&#x27;Courier New&#x27;&gt;raw_reccobeats&lt;/font&gt;.&lt;br&gt;Không dùng ReccoBeats UUID làm khóa — nối bằng ISRC / Spotify ID." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#006978;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1346" y="524" width="428" height="120" as="geometry"/></mxCell><mxCell id="enr_gap" value="&lt;b&gt;⚠ Coverage ReccoBeats&lt;/b&gt;&lt;br&gt;E2E 16/11: &lt;b&gt;26/40&lt;/b&gt;, #1–#6 thiếu. Chạy thật: 12/11 → 32/50 (64%), 19/11 → 33/50 (66%).&lt;br&gt;Ghi &lt;font face=&#x27;Courier New&#x27;&gt;features_found=false&lt;/font&gt;, giữ hàng chart (LEFT JOIN)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#B71C1C;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1346" y="656" width="428" height="110" as="geometry"/></mxCell><mxCell id="enr_backfill" value="&lt;b&gt;Vòng backfill&lt;/b&gt; (giữ từ v1)&lt;br&gt;Lấy &lt;font face=&#x27;Courier New&#x27;&gt;features_found=false&lt;/font&gt; từ Silver, gọi lại ReccoBeats&lt;br&gt;(≤ 40, retry 429), cập nhật &lt;font face=&#x27;Courier New&#x27;&gt;dim_track&lt;/font&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#006978;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1346" y="778" width="428" height="100" as="geometry"/></mxCell><mxCell id="enr_dep" value="&lt;b&gt;Trường Web API đã deprecated / gỡ (docs 16/11/2026)&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;track.popularity&lt;/font&gt;: Deprecated; Dev Mode = REMOVED.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist.genres&lt;/font&gt;: Deprecated (không nằm list REMOVED).&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist.followers&lt;/font&gt; / &lt;font face=&#x27;Courier New&#x27;&gt;artist.popularity&lt;/font&gt;: Deprecated + REMOVED với Dev Mode mới.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;album.genres&lt;/font&gt;: Deprecated, docs nói mảng luôn rỗng.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;external_ids&lt;/font&gt; (ISRC): tháng 3/2026 &lt;b&gt;reverted&lt;/b&gt; — vẫn có." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=9;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#E65100;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1346" y="890" width="428" height="164" as="geometry"/></mxCell><mxCell id="enr_note" value="&lt;b&gt;Phân vai&lt;/b&gt; — &lt;font color=&#x27;#2E7D32&#x27;&gt;as-built&lt;/font&gt;&lt;br&gt;Task bronze chỉ gọi API + ghi Bronze. Silver/Gold là hai task riêng gọi builder Python (không dbt)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1346" y="1066" width="428" height="138" as="geometry"/></mxCell><mxCell id="slv_dbt" value="&lt;b&gt;Python builders&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;build_silver&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;SQL từ &lt;font face=&#x27;Courier New&#x27;&gt;docs/sql&lt;/font&gt; · đọc Bronze mới nhất (latest run_id)&lt;br&gt;→ upsert fact_chart, dim_track, dim_artist, bridge,&lt;br&gt;features_found (chạy lại không trùng).&lt;br&gt;dbt: BACKLOG (SPEC_V2 §19a)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1846" y="194" width="398" height="176" as="geometry"/></mxCell><mxCell id="slv_fact" value="&lt;b&gt;fact_chart&lt;/b&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;chart_date, chart_type, country&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;track_id, rank, prev_rank&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;streams&lt;/font&gt; — &lt;b&gt;nullable&lt;/b&gt; (public/v0 = NULL)&lt;br&gt;+ &lt;font face=&#x27;Courier New&#x27;&gt;run_id, ingested_at, source&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1846" y="382" width="398" height="130" as="geometry"/></mxCell><mxCell id="slv_dimt" value="&lt;b&gt;dim_track&lt;/b&gt;&lt;br&gt;• Metadata Spotify: tên, duration, explicit,&lt;br&gt;&amp;nbsp;&amp;nbsp;album, &lt;font face=&#x27;Courier New&#x27;&gt;release_date&lt;/font&gt;, ISRC&lt;br&gt;• ReccoBeats UUID + 11 audio features&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;features_found&lt;/font&gt; (bool)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;popularity&lt;/font&gt; luôn NULL với Dev Mode&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;updated_at, updated_by_run_id&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1846" y="524" width="398" height="168" as="geometry"/></mxCell><mxCell id="slv_dima" value="&lt;b&gt;dim_artist&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist_id, name&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;genres / followers / popularity&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;deprecated — Dev Mode thường để trống" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1846" y="704" width="398" height="110" as="geometry"/></mxCell><mxCell id="slv_bridge" value="&lt;b&gt;bridge_track_artist&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nối nhiều nghệ sĩ cho một bài&lt;br&gt;(không có trong model gốc v1)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1846" y="826" width="398" height="110" as="geometry"/></mxCell><mxCell id="slv_join" value="&lt;b&gt;LEFT JOIN&lt;/b&gt; (giữ từ v1)&lt;br&gt;fact → dim_track → bridge → dim_artist.&lt;br&gt;Giữ mọi hàng chart khi thiếu feature / genre." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1846" y="948" width="398" height="96" as="geometry"/></mxCell><mxCell id="slv_dq" value="&lt;b&gt;DQ Silver — cổng chặn trước Gold — BACKLOG&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;chưa triển khai (SPEC_V2 §19a)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ý tưởng FAIL (dừng, không refresh Gold):&lt;/b&gt;&lt;br&gt;• Mỗi &lt;font face=&#x27;Courier New&#x27;&gt;chart_date&lt;/font&gt; đúng &lt;b&gt;50&lt;/b&gt; dòng&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;track_id&lt;/font&gt; not null; rank 1–50, không trùng&lt;br&gt;• Khóa chính unique; fact.track_id ∈ dim_track&lt;br&gt;• Features trong [0, 1]; &lt;font face=&#x27;Courier New&#x27;&gt;tempo &amp;gt; 0&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1846" y="1056" width="398" height="148" as="geometry"/></mxCell><mxCell id="gld_movers" value="&lt;b&gt;gold_movers&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;VIEW&lt;/font&gt;&lt;br&gt;Tăng / giảm hạng, new entry, re-entry.&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;streams+&lt;/font&gt; chỉ khi streams không null&lt;br&gt;(public/v0 thì bỏ qua)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2316" y="194" width="368" height="120" as="geometry"/></mxCell><mxCell id="gld_cov" value="&lt;b&gt;gold_feature_coverage&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;VIEW&lt;/font&gt;&lt;br&gt;Tỷ lệ bài đã có audio features&lt;br&gt;theo tuần / chart. Dùng cho DQ Gold&lt;br&gt;và dashboard coverage." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2316" y="326" width="368" height="118" as="geometry"/></mxCell><mxCell id="gld_mood" value="&lt;b&gt;gold_mood_segments&lt;/b&gt; · &lt;font face=&#x27;Courier New&#x27;&gt;VIEW&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;as-built&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mood theo watermark, tính từ Silver.&lt;br&gt;Materialized view / snapshot theo tuần&lt;br&gt;(&lt;font face=&#x27;Courier New&#x27;&gt;chart_date + run_id&lt;/font&gt;): BACKLOG." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2316" y="456" width="368" height="180" as="geometry"/></mxCell><mxCell id="gld_rank" value="&lt;b&gt;Rank vs audio features — BUILT&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;view gold_rank_features (SPEC_V2 §19c)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Thay cho &amp;quot;popularity vs features&amp;quot;.&lt;br&gt;Cặp (rank, 9 features) theo tuần, chỉ features_found.&lt;br&gt;(popularity luôn NULL ở Dev Mode)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2316" y="648" width="368" height="140" as="geometry"/></mxCell><mxCell id="gld_pop" value="&lt;b&gt;⚠ Không dùng: popularity vs features&lt;/b&gt;&lt;br&gt;Giữ từ sơ đồ v1 nhưng &lt;b&gt;không làm được&lt;/b&gt;:&lt;br&gt;app Dev Mode không trả &lt;font face=&#x27;Courier New&#x27;&gt;track.popularity&lt;/font&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#B71C1C;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2316" y="800" width="368" height="110" as="geometry"/></mxCell><mxCell id="gld_dq" value="&lt;b&gt;DQ Gold — BACKLOG&lt;/b&gt;&lt;br&gt;Coverage thực tế 64–66%, nên ngưỡng 80% sẽ luôn WARN/FAIL.&lt;br&gt;&lt;font color=&#x27;#E65100&#x27;&gt;Ngưỡng và mức (WARN/FAIL): chưa quyết&lt;/font&gt; (SPEC_V2 §19a)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#E65100;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2316" y="922" width="368" height="130" as="geometry"/></mxCell><mxCell id="gld_api" value="&lt;b&gt;Data API — BACKLOG&lt;/b&gt; (chỉ expose Gold)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;chưa triển khai (BI hoãn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Header: &lt;font face=&#x27;Courier New&#x27;&gt;Accept-Profile: music_gold&lt;/font&gt;&lt;br&gt;Bronze / Silver không mở REST.&lt;br&gt;GRANT SELECT cho &lt;font face=&#x27;Courier New&#x27;&gt;api_reader&lt;/font&gt; / service đọc Gold." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2316" y="1064" width="368" height="140" as="geometry"/></mxCell><mxCell id="srv_be" value="&lt;b&gt;BE — FastAPI — BACKLOG&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;chưa triển khai (BI hoãn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Luồng: UI → BE → Supabase Gold.&lt;br&gt;Đọc Gold bằng một trong hai cách:&lt;br&gt;• PostgREST + &lt;font face=&#x27;Courier New&#x27;&gt;Accept-Profile: music_gold&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;psycopg&lt;/font&gt; / SQLAlchemy, role &lt;font face=&#x27;Courier New&#x27;&gt;api_reader&lt;/font&gt;&lt;br&gt;Ví dụ: &lt;font face=&#x27;Courier New&#x27;&gt;/api/movers&lt;/font&gt;,&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;/api/mood-segments&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;/api/coverage&lt;/font&gt;.&lt;br&gt;Secret giữ phía BE — &lt;b&gt;không lộ ra frontend&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2756" y="194" width="418" height="230" as="geometry"/></mxCell><mxCell id="srv_ui" value="&lt;b&gt;UI — Streamlit hoặc Next.js — BACKLOG&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;chưa triển khai (BI hoãn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Streamlit&lt;/b&gt;: ưu tiên cho demo&lt;br&gt;&amp;nbsp;&amp;nbsp;(repo Python hiện tại, Cloud miễn phí).&lt;br&gt;• Next.js / React: nếu cần web app.&lt;br&gt;UI &lt;b&gt;chỉ gọi BE&lt;/b&gt;.&lt;br&gt;Phương án phụ: key &lt;font face=&#x27;Courier New&#x27;&gt;anon&lt;/font&gt; + RLS&lt;br&gt;chỉ &lt;font face=&#x27;Courier New&#x27;&gt;SELECT&lt;/font&gt; trên Gold — không dùng&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;service_role&lt;/font&gt; ở frontend." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2756" y="436" width="418" height="210" as="geometry"/></mxCell><mxCell id="srv_dash" value="&lt;b&gt;Nội dung dashboard (BACKLOG)&lt;/b&gt;&lt;br&gt;• Hạng theo tuần, movers (up/down/new/re-entry)&lt;br&gt;• Mood mix (valence / energy / …) theo tuần&lt;br&gt;• Coverage ReccoBeats (features_found)&lt;br&gt;• &lt;b&gt;Rank vs audio features&lt;/b&gt; (thay popularity)&lt;br&gt;• Tình trạng pipeline (&lt;font face=&#x27;Courier New&#x27;&gt;ops_pipeline_health&lt;/font&gt;)&lt;br&gt;Không vẽ popularity vs features (Dev Mode)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2756" y="648" width="418" height="186" as="geometry"/></mxCell><mxCell id="srv_meta" value="&lt;b&gt;Metabase / Grafana&lt;/b&gt; (tùy chọn)&lt;br&gt;Kết nối thẳng Postgres, chỉ đọc Gold.&lt;br&gt;Hợp cho demo kéo-thả, không cần viết UI.&lt;br&gt;&lt;font color=&#x27;#E65100&#x27;&gt;Công cụ cụ thể: giả định – cần xác nhận&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#F9A825;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#E65100;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2756" y="846" width="418" height="126" as="geometry"/></mxCell><mxCell id="srv_rls" value="&lt;b&gt;Lưu ý quyền đọc&lt;/b&gt;&lt;br&gt;Nếu UI gọi thẳng Supabase bằng &lt;font face=&#x27;Courier New&#x27;&gt;anon&lt;/font&gt;:&lt;br&gt;phải GRANT SELECT view Gold + bật RLS&lt;br&gt;trên bảng Silver, nếu không sẽ ra rỗng / 401 / 403.&lt;br&gt;Đi qua BE + role &lt;font face=&#x27;Courier New&#x27;&gt;api_reader&lt;/font&gt; thì tránh được." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2756" y="984" width="418" height="220" as="geometry"/></mxCell><mxCell id="plat" value="&lt;b&gt;8–12. Nền tảng vận hành — BACKLOG (chưa triển khai, SPEC_V2 §19a)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="1266" width="3160" height="280" as="geometry"/></mxCell><mxCell id="plat_mig" value="&lt;b&gt;8. Schema migration — Supabase CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;BACKLOG — chưa triển khai (SPEC_V2 §19a)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;supabase/migrations/&lt;/font&gt; đánh số theo thời gian&lt;br&gt;• Gồm: &lt;font face=&#x27;Courier New&#x27;&gt;CREATE SCHEMA&lt;/font&gt; music_raw / silver / gold,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;GRANT&lt;/font&gt;, index, bảng &lt;font face=&#x27;Courier New&#x27;&gt;raw_*&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;pipeline_runs&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;dq_results&lt;/font&gt;&lt;br&gt;• Baseline: &lt;font face=&#x27;Courier New&#x27;&gt;supabase db pull&lt;/font&gt; từ schema hiện có (&lt;font face=&#x27;Courier New&#x27;&gt;music&lt;/font&gt;)&lt;br&gt;• Áp dụng: &lt;font face=&#x27;Courier New&#x27;&gt;supabase db push&lt;/font&gt;&lt;br&gt;• dbt quản lý bảng / view Silver và Gold — migration không tạo các object đó" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="46" y="1308" width="612" height="220" as="geometry"/></mxCell><mxCell id="plat_ci" value="&lt;b&gt;9. CI/CD — GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;BACKLOG — chưa triển khai (SPEC_V2 §19a)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Workflow &lt;font face=&#x27;Courier New&#x27;&gt;.github/workflows/ci.yml&lt;/font&gt; khi push / PR:&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;ruff check&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;ruff format --check&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;pytest&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;dbt parse&lt;/font&gt; / &lt;font face=&#x27;Courier New&#x27;&gt;dbt build&lt;/font&gt; trên Postgres service&lt;br&gt;• Test import DAG Airflow&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;gitleaks&lt;/font&gt; — chặn commit secret&lt;br&gt;CD (làm sau): &lt;font face=&#x27;Courier New&#x27;&gt;supabase db push&lt;/font&gt; khi merge &lt;font face=&#x27;Courier New&#x27;&gt;main&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#E65100&#x27;&gt;môi trường dev riêng: giả định – cần xác nhận&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="674" y="1308" width="612" height="220" as="geometry"/></mxCell><mxCell id="plat_mon" value="&lt;b&gt;10. Giám sát (Monitoring)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;BACKLOG — chưa triển khai (SPEC_V2 §19a)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;on_failure_callback&lt;/font&gt; → Slack / Email / Telegram&lt;br&gt;&amp;nbsp;&amp;nbsp;(kênh cụ thể: &lt;font color=&#x27;#E65100&#x27;&gt;giả định – cần xác nhận&lt;/font&gt;)&lt;br&gt;• Freshness: &lt;font face=&#x27;Courier New&#x27;&gt;max(chart_date)&lt;/font&gt; &amp;gt; &lt;b&gt;8 ngày&lt;/b&gt; thì báo&lt;br&gt;&amp;nbsp;&amp;nbsp;(mốc 8 ngày: &lt;font color=&#x27;#E65100&#x27;&gt;giả định – cần xác nhận&lt;/font&gt;)&lt;br&gt;• Volume anomaly: số dòng / coverage giảm mạnh vs tuần trước&lt;br&gt;• Xem nhanh: view &lt;font face=&#x27;Courier New&#x27;&gt;ops_pipeline_health&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1302" y="1308" width="612" height="220" as="geometry"/></mxCell><mxCell id="plat_sec" value="&lt;b&gt;11. Bảo mật (least privilege)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;BACKLOG — chưa triển khai (SPEC_V2 §19a)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Ngay:&lt;/b&gt; rotate &lt;font face=&#x27;Courier New&#x27;&gt;service_role&lt;/font&gt; đã lộ + Spotify client secret&lt;br&gt;• 3 role Postgres riêng (không dùng service_role cho mọi việc):&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;pipeline_writer&lt;/font&gt; — INSERT/UPDATE raw, silver, runs&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;dbt_transformer&lt;/font&gt; — đọc bronze/silver, ghi silver/gold&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;api_reader&lt;/font&gt; — chỉ SELECT trên Gold&lt;br&gt;• Secret: &lt;font face=&#x27;Courier New&#x27;&gt;.env&lt;/font&gt; (local) · Airflow Connections · GitHub Secrets" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1930" y="1308" width="612" height="220" as="geometry"/></mxCell><mxCell id="plat_ops" value="&lt;b&gt;12. Metadata lần chạy + lineage&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;BACKLOG — chưa triển khai (SPEC_V2 §19a)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Từ một dòng Gold lần ngược được:&lt;br&gt;Gold → Silver (&lt;font face=&#x27;Courier New&#x27;&gt;updated_by_run_id&lt;/font&gt;)&lt;br&gt;→ &lt;font face=&#x27;Courier New&#x27;&gt;pipeline_runs&lt;/font&gt; → JSON thô Bronze&lt;br&gt;(cùng &lt;font face=&#x27;Courier New&#x27;&gt;run_id&lt;/font&gt; + &lt;font face=&#x27;Courier New&#x27;&gt;source&lt;/font&gt;).&lt;br&gt;dbt docs cung cấp sơ đồ phụ thuộc model.&lt;br&gt;Coi là xong khi truy vết được mọi dòng Gold." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=4;fontColor=#232F3E;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="2558" y="1308" width="612" height="220" as="geometry"/></mxCell><mxCell id="legend_swatch" value="&lt;b&gt;Màu lớp / ký hiệu&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1565C0&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Nguồn Charts / Web API (đã test)&lt;br&gt;&lt;font color=&#x27;#00838F&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; ReccoBeats + bước Enrich (EL)&lt;br&gt;&lt;font color=&#x27;#7B1FA2&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Orchestrator / watermark / DAG&lt;br&gt;&lt;font color=&#x27;#E65100&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Bronze · &lt;font face=&#x27;Courier New&#x27;&gt;music.raw_*&lt;/font&gt; (tách music_raw: BACKLOG)&lt;br&gt;&lt;font color=&#x27;#455A64&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Silver · &lt;font face=&#x27;Courier New&#x27;&gt;music.*&lt;/font&gt; (Python builders; dbt: BACKLOG)&lt;br&gt;&lt;font color=&#x27;#F9A825&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Gold · &lt;font face=&#x27;Courier New&#x27;&gt;music.gold_*&lt;/font&gt; (VIEW)&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Serving / BI (BACKLOG)&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;□ nét đứt xanh lá&lt;/b&gt;&lt;/font&gt; = v2.1: as-built hoặc BACKLOG (xem nhãn từng khối)&lt;br&gt;&lt;font color=&#x27;#F9A825&#x27;&gt;&lt;b&gt;□ nét đứt vàng&lt;/b&gt;&lt;/font&gt; = giả định – cần xác nhận&lt;br&gt;&lt;font color=&#x27;#C62828&#x27;&gt;&lt;b&gt;□ nét đứt đỏ&lt;/b&gt;&lt;/font&gt; = rủi ro đã quan sát / ToS" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FAFAFA;strokeColor=#90A4AE;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="30" y="1564" width="620" height="270" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú giải (legend)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mũi tên liền:&lt;/b&gt; luồng chính — Sources → Airflow (bronze → build_silver → build_gold) → Bronze / Silver / Gold. DQ gate, FastAPI, UI: BACKLOG.&lt;br&gt;&lt;b&gt;Mũi tên đứt tím:&lt;/b&gt; vòng backfill ReccoBeats cho bài &lt;font face=&#x27;Courier New&#x27;&gt;features_found=false&lt;/font&gt;.&lt;br&gt;&lt;b&gt;Mũi tên đứt xanh lá:&lt;/b&gt; Client Credentials / secret từ Airflow Connections sang Web API.&lt;br&gt;&lt;b&gt;Mũi tên đứt cam:&lt;/b&gt; nguồn auth/v0 daily + streams, hoặc công cụ tùy chọn (Storage, Metabase/Grafana) — giả định – cần xác nhận.&lt;br&gt;&lt;b&gt;Cổng DQ:&lt;/b&gt; lỗi nghiêm trọng (thiếu dòng, trùng khóa, rank sai) thì dừng, không refresh Gold. Lỗi nhẹ (coverage thấp) chỉ WARN.&lt;br&gt;&lt;b&gt;Watermark&lt;/b&gt; = &lt;font face=&#x27;Courier New&#x27;&gt;chart_date + chart_type + country&lt;/font&gt;. Silver luôn &lt;b&gt;LEFT JOIN&lt;/b&gt;. Feature lấy từ ReccoBeats, không dùng endpoint Spotify đã khoá (27/11/2024).&lt;br&gt;Schema đang có trên project là &lt;font face=&#x27;Courier New&#x27;&gt;music&lt;/font&gt; (có &lt;font face=&#x27;Courier New&#x27;&gt;gold_movers&lt;/font&gt;). Tách &lt;font face=&#x27;Courier New&#x27;&gt;music_raw / music_silver / music_gold&lt;/font&gt; là BACKLOG (cần migration)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FAFAFA;strokeColor=#90A4AE;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="666" y="1564" width="1180" height="270" as="geometry"/></mxCell><mxCell id="changelog" value="&lt;b&gt;Thay đổi v1 → v2.0 (19/11) → v2.1 as-built (26/11/2026)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Orchestrator (as-built):&lt;/b&gt; Airflow DAG &lt;font face=&#x27;Courier New&#x27;&gt;spotify_weekly&lt;/font&gt; (Docker Compose local), 3 task, retries=1, &lt;font face=&#x27;Courier New&#x27;&gt;catchup=False&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;max_active_runs=1&lt;/font&gt;, lịch Mon 09:00.&lt;br&gt;• &lt;b&gt;Lưu trữ (as-built):&lt;/b&gt; Supabase Postgres, schema &lt;font face=&#x27;Courier New&#x27;&gt;music&lt;/font&gt;. Tách schema và Storage JSON thô: BACKLOG.&lt;br&gt;• &lt;b&gt;Transform (as-built):&lt;/b&gt; Python builders (&lt;font face=&#x27;Courier New&#x27;&gt;docs/sql&lt;/font&gt;) cho Silver/Gold. dbt: BACKLOG.&lt;br&gt;• &lt;b&gt;Catch-up:&lt;/b&gt; public/v0 chỉ có tuần live nên ~8 tuần tích lũy dần qua schedule (không backfill).&lt;br&gt;• &lt;b&gt;BACKLOG (từ đề xuất v2.0):&lt;/b&gt; DQ gate · migration CLI · CI/CD · giám sát · 3 role · &lt;font face=&#x27;Courier New&#x27;&gt;pipeline_runs&lt;/font&gt; (run_id trên raw đã có).&lt;br&gt;• &lt;b&gt;Serving:&lt;/b&gt; BACKLOG (BI hoãn).&lt;br&gt;• &lt;b&gt;Gold (as-built):&lt;/b&gt; 3 VIEW (coverage, movers, mood); không dùng &amp;quot;popularity vs features&amp;quot; (Dev Mode không có popularity). &lt;font face=&#x27;Courier New&#x27;&gt;bridge_track_artist&lt;/font&gt; có trong Silver." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;dashPattern=8 6;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="1862" y="1564" width="1328" height="270" as="geometry"/></mxCell><mxCell id="foot" value="Bản v2.1 as-built cập nhật 26/11/2026 (Asia/Bangkok) — phần BACKLOG chưa triển khai (SPEC_V2 §19a). Giữ kết quả test nguồn 16/11/2026: Charts public/v0 Weekly Top Songs Global; Spotify Web API Client Credentials + giới hạn Dev Mode; ReccoBeats api.reccobeats.com (26/40 features).&lt;br&gt;Sơ đồ v1 giữ tại architecture/version_1/music-pipeline.drawio (16/11) · đề xuất gốc v2.0 giữ tại architecture/version_2/music-pipeline-v2.0.drawio (19/11). Không đụng 3 bảng thời tiết trong schema public. Key service_role không đưa vào sơ đồ." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#78909C;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="1842" width="3160" height="48" as="geometry"/></mxCell><mxCell id="e_ch_or" value="weekly JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#1565C0;endArrow=block;endFill=1;fontSize=9;fontColor=#1565C0;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="src_charts" target="orch_af"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="240"/><mxPoint x="490" y="239"/></Array></mxGeometry></mxCell><mxCell id="e_or_br" value="ingest + load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#7B1FA2;endArrow=block;endFill=1;fontSize=9;fontColor=#7B1FA2;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=1;exitY=0.14;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch_af" target="brz_schema"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="272"/><mxPoint x="910" y="241"/></Array></mxGeometry></mxCell><mxCell id="e_wm_br" value="watermark" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#7B1FA2;endArrow=block;endFill=1;fontSize=9;fontColor=#7B1FA2;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.78;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch_wm" target="brz_schema"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="829"/><mxPoint x="910" y="397"/></Array></mxGeometry></mxCell><mxCell id="e_br_ex" value="parse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#E65100;endArrow=block;endFill=1;fontSize=9;fontColor=#E65100;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="brz_schema" target="ex_ids"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="225"/><mxPoint x="1310" y="232"/></Array></mxGeometry></mxCell><mxCell id="e_ex_sp" value="track / artist IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#00838F;endArrow=block;endFill=1;fontSize=9;fontColor=#00838F;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex_ids" target="enr_sp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ex_rb" value="IDs ≤ 40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#006978;endArrow=block;endFill=1;fontSize=9;fontColor=#006978;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=1;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex_ids" target="enr_rb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1795" y="247"/><mxPoint x="1795" y="538"/></Array></mxGeometry></mxCell><mxCell id="e_sp_raw" value="raw API JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#00838F;endArrow=block;endFill=1;fontSize=9;fontColor=#00838F;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 6;strokeWidth=1.5;exitX=0;exitY=0.22;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="enr_sp" target="brz_schema"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="348"/><mxPoint x="1310" y="337"/></Array></mxGeometry></mxCell><mxCell id="e_rb_raw" value="raw RB JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#006978;endArrow=block;endFill=1;fontSize=9;fontColor=#006978;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 6;strokeWidth=1.5;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.92;entryDx=0;entryDy=0;" edge="1" parent="1" source="enr_rb" target="brz_schema"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="548"/><mxPoint x="1310" y="433"/></Array></mxGeometry></mxCell><mxCell id="e_ex_fact" value="chart rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#455A64;endArrow=block;endFill=1;fontSize=9;fontColor=#455A64;labelBackgroundColor=#ffffff;dashed=0;strokeWidth=1.5;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex_ids" target="slv_fact"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="221"/><mxPoint x="1810" y="405"/></Array></mxGeometry></mxCell><mxCell id="e_sp_dimt" value="metadata + ISRC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#00838F;endArrow=block;endFill=1
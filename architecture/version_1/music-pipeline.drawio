<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Grok Bot" version="32.5.5">
<diagram id="music-pipeline-v2" name="Pipeline nhạc v2 (đã chốt)"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Original" parent="0"/><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CFD8DC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2720" height="1520" as="geometry"/></mxCell><mxCell id="title" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;Pipeline đã chốt (16/11/2026) — Spotify Charts + Spotify Web API + ReccoBeats → Medallion → BI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#546E7A&#x27;&gt;Stack nguồn đã chốt · công cụ scheduler / secret store / lake / BI vẫn gắn &lt;b&gt;&amp;quot;giả định – cần xác nhận&amp;quot;&lt;/b&gt; · không dùng kworb / Last.fm / Kaggle / Deezer trên luồng chính (chỉ còn footnote fallback)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#263238;fontSize=14;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="2180" height="70" as="geometry"/></mxCell><mxCell id="badge" value="&lt;b&gt;STACK ĐÃ CHỐT&lt;/b&gt;&lt;br&gt;16/11/2026 · Asia/Bangkok" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;fontColor=#2E7D32;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2460" y="14" width="230" height="56" as="geometry"/></mxCell><mxCell id="col_src" value="&lt;b&gt;1. Nguồn đã chốt (Sources)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="460" height="980" as="geometry"/></mxCell><mxCell id="col_orch" value="&lt;b&gt;2. Orchestrator&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="320" height="620" as="geometry"/></mxCell><mxCell id="col_brz" value="&lt;b&gt;3. Bronze (raw)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="890" y="90" width="310" height="620" as="geometry"/></mxCell><mxCell id="col_enr" value="&lt;b&gt;4. Extract ID + enrichment song song&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="500" height="980" as="geometry"/></mxCell><mxCell id="col_slv" value="&lt;b&gt;5. Silver (modeled)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1780" y="90" width="420" height="780" as="geometry"/></mxCell><mxCell id="col_gld" value="&lt;b&gt;6. Gold (serving)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2240" y="90" width="450" height="500" as="geometry"/></mxCell><mxCell id="col_bi" value="&lt;b&gt;7. BI / Dashboard&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2240" y="610" width="450" height="260" as="geometry"/></mxCell><mxCell id="src_pub" value="&lt;b&gt;Spotify Charts — public/v0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1565C0&#x27;&gt;&lt;b&gt;KHÔNG CẦN AUTH · ĐÃ TEST 16/11/2026&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Service: charts-spotify-com-service&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;public/v0/charts&lt;/font&gt; (unauthenticated)&lt;br&gt;• Weekly Top Songs: Global, &lt;b&gt;top 50&lt;/b&gt;&lt;br&gt;• Có: current/previous rank, &lt;font face=&#x27;Courier New&#x27;&gt;trackUri&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;tên bài / nghệ sĩ, entryStatus&lt;br&gt;• &lt;b&gt;Không có streams&lt;/b&gt;&lt;br&gt;• Cadence quan sát được: &lt;b&gt;weekly&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="134" width="428" height="220" as="geometry"/></mxCell><mxCell id="src_auth" value="&lt;b&gt;Spotify Charts — auth/v0 daily&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;GIẢ ĐỊNH – CẦN XÁC NHẬN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Daily &lt;b&gt;Top 200&lt;/b&gt; + &lt;b&gt;streams&lt;/b&gt;&lt;br&gt;• Cần Bearer token của user đã đăng nhập&lt;br&gt;&amp;nbsp;&amp;nbsp;(không phải Client Credentials)&lt;br&gt;• Thời hạn token: &lt;b&gt;chưa kiểm chứng&lt;/b&gt;&lt;br&gt;• Test trước đó: endpoint cần auth → 401,&lt;br&gt;&amp;nbsp;&amp;nbsp;CSV rỗng — chưa gọi thành công&lt;br&gt;• Rủi ro ToS (cấm scrape Charts)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="46" y="370" width="428" height="230" as="geometry"/></mxCell><mxCell id="src_risk" value="&lt;b&gt;⚠ Rủi ro Charts&lt;/b&gt;&lt;br&gt;• Không có official Charts API cho developer.&lt;br&gt;• public/v0 là endpoint &lt;b&gt;không chính thức&lt;/b&gt;.&lt;br&gt;• ToS Spotify cấm scraping Charts.&lt;br&gt;• auth/v0 + token user: rủi ro điều khoản,&lt;br&gt;&amp;nbsp;&amp;nbsp;token có thể hết hạn / bị thu hồi.&lt;br&gt;• Nếu chỉ dùng public/v0: scheduler &lt;b&gt;weekly&lt;/b&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&#x27;Courier New&#x27;&gt;streams = NULL&lt;/font&gt;." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#B71C1C;dashed=1;" vertex="1" parent="1"><mxGeometry x="46" y="616" width="428" height="200" as="geometry"/></mxCell><mxCell id="src_note" value="&lt;b&gt;Footnote — không nằm trên luồng chính&lt;/b&gt;&lt;br&gt;kworb (daily HTML + streams), Last.fm, Kaggle 1.2M,&lt;br&gt;Deezer: chỉ còn phương án &lt;b&gt;fallback&lt;/b&gt; nếu Charts&lt;br&gt;auth/v0 không dùng được — không vẽ vào pipeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;dashed=1;dashPattern=8 6;fontSize=10;align=left;spacing=8;fontColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="46" y="832" width="428" height="120" as="geometry"/></mxCell><mxCell id="orch_sched" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Daily&lt;/b&gt; nếu auth/v0 daily chạy được.&lt;br&gt;• &lt;b&gt;Weekly&lt;/b&gt; nếu chỉ có public/v0.&lt;br&gt;Enrichment (Web API + ReccoBeats)&lt;br&gt;chạy sau khi có ID từ chart.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;Công cụ scheduler:&lt;/b&gt;&lt;br&gt;giả định – cần xác nhận&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="546" y="134" width="288" height="190" as="geometry"/></mxCell><mxCell id="orch_wm" value="&lt;b&gt;Watermark&lt;/b&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;chart_date&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;chart_type&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;country&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Incremental: chỉ kéo bản chart&lt;br&gt;chưa ingest (hoặc đã đổi)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="546" y="340" width="288" height="170" as="geometry"/></mxCell><mxCell id="orch_secret" value="&lt;b&gt;Secret store&lt;/b&gt;&lt;br&gt;Spotify &lt;b&gt;Client ID / Client Secret&lt;/b&gt;&lt;br&gt;(Client Credentials, token ~1 giờ).&lt;br&gt;Không commit secret vào repo.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;Công cụ secret:&lt;/b&gt;&lt;br&gt;giả định – cần xác nhận&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="546" y="526" width="288" height="164" as="geometry"/></mxCell><mxCell id="brz_raw" value="&lt;b&gt;Landing zone — raw JSON as-is&lt;/b&gt;&lt;br&gt;• Raw Spotify Charts JSON&lt;br&gt;&amp;nbsp;&amp;nbsp;(public/v0 và/hoặc auth/v0)&lt;br&gt;• Raw Spotify Web API JSON&lt;br&gt;&amp;nbsp;&amp;nbsp;(tracks / artists / albums)&lt;br&gt;• Raw ReccoBeats JSON&lt;br&gt;&amp;nbsp;&amp;nbsp;(audio-features, track)&lt;br&gt;&lt;br&gt;Mọi object gắn &lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;ingested_at&lt;/b&gt;&lt;/font&gt;.&lt;br&gt;Không transform ở lớp này." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906" y="134" width="278" height="250" as="geometry"/></mxCell><mxCell id="brz_store" value="&lt;b&gt;Lưu trữ Bronze&lt;/b&gt;&lt;br&gt;Object store / lake, phân vùng&lt;br&gt;theo watermark + ingested_at.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;Công cụ lưu trữ:&lt;/b&gt;&lt;br&gt;giả định – cần xác nhận&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="906" y="404" width="278" height="160" as="geometry"/></mxCell><mxCell id="ex_ids" value="&lt;b&gt;Extract Spotify track / artist IDs&lt;/b&gt;&lt;br&gt;Từ &lt;font face=&#x27;Courier New&#x27;&gt;trackUri&lt;/font&gt; (&lt;font face=&#x27;Courier New&#x27;&gt;spotify:track:{id}&lt;/font&gt;) → track_id 22 ký tự.&lt;br&gt;Artist ID lấy sau từ payload Web API &lt;font face=&#x27;Courier New&#x27;&gt;tracks.artists[].id&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="134" width="428" height="96" as="geometry"/></mxCell><mxCell id="enr_sp" value="&lt;b&gt;Spotify Web API&lt;/b&gt; · official · Client Credentials · token &lt;b&gt;1 giờ&lt;/b&gt;&lt;br&gt;Làm giàu &lt;b&gt;metadata&lt;/b&gt; (không lấy audio-features):&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/tracks?ids=&lt;/font&gt; — max &lt;b&gt;50&lt;/b&gt; (docs 16/11/2026)&lt;br&gt;&amp;nbsp;&amp;nbsp;tên, duration, ISRC (&lt;font face=&#x27;Courier New&#x27;&gt;external_ids&lt;/font&gt;), album, &lt;font face=&#x27;Courier New&#x27;&gt;release_date&lt;/font&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/artists?ids=&lt;/font&gt; — max &lt;b&gt;50&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/albums?ids=&lt;/font&gt; — max &lt;b&gt;20&lt;/b&gt; (bổ sung, tùy chọn)&lt;br&gt;&lt;font color=&#x27;#C62828&#x27;&gt;&lt;b&gt;App Dev Mode mới (từ 11/02/2026):&lt;/b&gt; ba endpoint batch trên&lt;br&gt;đã bị gỡ — fallback &lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/tracks/{id}&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;/artists/{id}&lt;/font&gt;,&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;/albums/{id}&lt;/font&gt; (từng id). Extended Quota không bị ảnh hưởng.&lt;/font&gt;&lt;br&gt;&lt;b&gt;Không dùng&lt;/b&gt; (khoá app mới từ 27/11/2024): audio-features,&lt;br&gt;recommendations, related-artists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#80DEEA;strokeColor=#00838F;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="246" width="428" height="290" as="geometry"/></mxCell><mxCell id="enr_rb" value="&lt;b&gt;ReccoBeats&lt;/b&gt; · song song với Web API · không cần key&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;GET /v1/audio-features?ids=&lt;/font&gt; — batch &lt;b&gt;≤ 40&lt;/b&gt; Spotify ID&lt;br&gt;Retry &lt;b&gt;429&lt;/b&gt; / &lt;b&gt;Retry-After&lt;/b&gt; (ngưỡng không công bố)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#006978;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="552" width="428" height="110" as="geometry"/></mxCell><mxCell id="enr_gap" value="&lt;b&gt;⚠ Coverage ReccoBeats&lt;/b&gt;&lt;br&gt;E2E 16/11/2026: Weekly Top 40 Global → &lt;b&gt;26/40&lt;/b&gt;, &lt;b&gt;#1–#6 thiếu&lt;/b&gt;.&lt;br&gt;Ghi &lt;font face=&#x27;Courier New&#x27;&gt;features_found=false&lt;/font&gt;, giữ hàng chart (LEFT JOIN)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#B71C1C;dashed=1;" vertex="1" parent="1"><mxGeometry x="1256" y="678" width="428" height="110" as="geometry"/></mxCell><mxCell id="enr_backfill" value="&lt;b&gt;Vòng backfill&lt;/b&gt; — lấy &lt;font face=&#x27;Courier New&#x27;&gt;features_found=false&lt;/font&gt;&lt;br&gt;từ Silver, gọi lại ReccoBeats (≤ 40, retry 429), cập nhật dim_track." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#006978;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="804" width="428" height="90" as="geometry"/></mxCell><mxCell id="enr_dep" value="&lt;b&gt;Trường Web API đã deprecated / gỡ (docs 16/11/2026)&lt;/b&gt;&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;track.popularity&lt;/font&gt;: Deprecated; Dev Mode Feb/2026 liệt kê REMOVED.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist.genres&lt;/font&gt;: Deprecated (không nằm trong list REMOVED).&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;artist.followers&lt;/font&gt; / &lt;font face=&#x27;Courier New&#x27;&gt;artist.popularity&lt;/font&gt;: Deprecated + REMOVED với Dev Mode mới từ 11/02/2026.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;album.genres&lt;/font&gt;: Deprecated, docs nói mảng luôn rỗng.&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;external_ids&lt;/font&gt; (ISRC): tháng 3/2026 &lt;b&gt;reverted&lt;/b&gt; — vẫn có." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;dashed=1;fontSize=9;align=left;spacing=6;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1256" y="906" width="428" height="148" as="geometry"/></mxCell><mxCell id="slv_fact" value="&lt;b&gt;fact_chart&lt;/b&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;chart_date, chart_type, country&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;track_id, rank, prev_rank&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;streams&lt;/font&gt; — &lt;b&gt;nullable&lt;/b&gt;&lt;br&gt;(chỉ có nếu auth/v0 daily chạy được;&lt;br&gt;public/v0 weekly = NULL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1796" y="134" width="388" height="160" as="geometry"/></mxCell><mxCell id="slv_dimt" value="&lt;b&gt;dim_track&lt;/b&gt;&lt;br&gt;• Metadata Spotify: tên, duration,&lt;br&gt;&amp;nbsp;&amp;nbsp;album, &lt;font face=&#x27;Courier New&#x27;&gt;release_date&lt;/font&gt;, ISRC&lt;br&gt;• ReccoBeats UUID + audio features&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;&lt;b&gt;features_found&lt;/b&gt;&lt;/font&gt; (bool)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;popularity&lt;/font&gt; nếu API còn trả&lt;br&gt;&amp;nbsp;&amp;nbsp;(deprecated / có thể null)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1796" y="310" width="388" height="170" as="geometry"/></mxCell><mxCell id="slv_dima" value="&lt;b&gt;dim_artist&lt;/b&gt;&lt;br&gt;• artist_id, name&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;genres&lt;/font&gt; (deprecated — nếu còn)&lt;br&gt;• &lt;font face=&#x27;Courier New&#x27;&gt;followers&lt;/font&gt;, &lt;font face=&#x27;Courier New&#x27;&gt;popularity&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(deprecated; Dev Mode mới có thể &lt;b&gt;không có&lt;/b&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1796" y="496" width="388" height="140" as="geometry"/></mxCell><mxCell id="slv_join" value="&lt;b&gt;LEFT JOIN&lt;/b&gt;&lt;br&gt;fact_chart.track_id = dim_track.track_id&lt;br&gt;dim_track.artist_id(s) = dim_artist.artist_id&lt;br&gt;Giữ mọi hàng chart khi thiếu feature / genre." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1796" y="652" width="388" height="120" as="geometry"/></mxCell><mxCell id="gld_movers" value="&lt;b&gt;Movers&lt;/b&gt;&lt;br&gt;Tăng / giảm hạng, new entry, re-entry;&lt;br&gt;streams+ chỉ khi streams không null." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2256" y="134" width="418" height="86" as="geometry"/></mxCell><mxCell id="gld_scd2" value="&lt;b&gt;SCD2 — lịch sử hạng&lt;/b&gt;&lt;br&gt;Type 2 theo track + chart_type + country:&lt;br&gt;valid_from / valid_to, is_current." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2256" y="234" width="418" height="90" as="geometry"/></mxCell><mxCell id="gld_mood" value="&lt;b&gt;Mood / genre analysis&lt;/b&gt;&lt;br&gt;Mood từ ReccoBeats (valence, energy…)&lt;br&gt;khi &lt;font face=&#x27;Courier New&#x27;&gt;features_found=true&lt;/font&gt;.&lt;br&gt;Genre phụ thuộc &lt;font face=&#x27;Courier New&#x27;&gt;artist.genres&lt;/font&gt; (deprecated)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2256" y="338" width="418" height="110" as="geometry"/></mxCell><mxCell id="gld_pop" value="&lt;b&gt;Popularity vs audio features&lt;/b&gt;&lt;br&gt;Chỉ khi &lt;font face=&#x27;Courier New&#x27;&gt;track.popularity&lt;/font&gt; còn được trả.&lt;br&gt;Dev Mode mới: trường này có thể absent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2256" y="462" width="418" height="90" as="geometry"/></mxCell><mxCell id="bi_dash" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;Hạng theo ngày/tuần, movers, SCD2,&lt;br&gt;mood mix, coverage ReccoBeats,&lt;br&gt;genre (nếu còn), popularity vs features (nếu còn).&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;&lt;b&gt;Công cụ BI:&lt;/b&gt; giả định – cần xác nhận&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="22
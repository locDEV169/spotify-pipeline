# Spotify Web API — Client Credentials (never commit real values)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Authorization Code flow — only for /v1/me/* (playlists, top items).
# Must match EXACTLY a Redirect URI in the Spotify Dashboard (127.0.0.1, not localhost).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback
# Filled by: python scripts/auth/spotify_login.py --save   (never commit)
SPOTIFY_REFRESH_TOKEN=

# Optional path overrides (defaults are relative to repo root)
# DATA_DIR=data
# BRONZE_DIR=data/bronze
# SILVER_DIR=data/silver
# GOLD_DIR=data/gold

# Optional batch sizes (SPEC: Spotify ≤50 when allowed; ReccoBeats ≤40)
# SPOTIFY_BATCH_SIZE=50
# RECCOBEATS_BATCH_SIZE=40

# Supabase (server/scripts only — never commit real values, never put SERVICE_ROLE in FE)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Postgres URI — required for DDL + bronze load scripts (Dashboard → Database → Connect).
# Best for pg8000 scripts: Session pooler on the *pooler* host, port 5432
#   …pooler.supabase.com:5432
# Avoid transaction pooler :6543 (08P01 / 26000 prepared-statement errors).
# Direct db.<ref>.supabase.co:5432 may time out on some networks — Session pooler is safer.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-....pooler.supabase.com:5432/postgres
